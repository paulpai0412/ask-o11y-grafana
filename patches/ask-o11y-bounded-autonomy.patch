--- /dev/null
+++ b/pkg/agent/analysis_autonomy_test.go
@@ -0,0 +1,232 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"consensys-asko11y-app/pkg/mcp"
+	"github.com/grafana/grafana-plugin-sdk-go/backend/log"
+)
+
+func autonomyCall(name, args string) ToolCall {
+	return ToolCall{ID: "call-1", Type: "function", Function: FunctionCall{Name: name, Arguments: args}}
+}
+
+func TestAutonomySelection(t *testing.T) {
+	s := &analysisAutonomy{catalog: []mcp.Tool{{Name: "sandbox-analysis_profile_dataset"}, {Name: "mcp-grafana_query_prometheus"}}}
+	_, _, catalog, err := s.selectCapabilities(`{}`, LoopRequest{})
+	if err != nil || !strings.Contains(catalog, "ml-method-selection") {
+		t.Fatalf("catalog: %s %v", catalog, err)
+	}
+	tools, skills, _, err := s.selectCapabilities(`{"tools":["sandbox-analysis_profile_dataset"],"skills":["ml-method-selection"]}`, LoopRequest{})
+	if err != nil || len(tools) != 1 || len(skills) != 1 {
+		t.Fatalf("selection: %v", err)
+	}
+	for _, args := range []string{
+		`{"tools":["disabled"],"skills":[]}`,
+		`{"tools":["mcp-grafana_query_prometheus"],"skills":[]}`,
+		`{"tools":[],"skills":["invented"]}`,
+		`{"tools":[],"skills":["dashboarding","dashboarding"]}`,
+		`{"tools":[],"skills":["dashboarding","ml-method-selection","data-understanding"]}`,
+		`{"tools":[],"skills":[],"publish":true}`, `null`, `{"tools":[]}`,
+	} {
+		if _, _, _, err := s.selectCapabilities(args, LoopRequest{}); err == nil {
+			t.Fatalf("accepted invalid selection %s", args)
+		}
+	}
+	messages := []Message{{Role: "system", Content: "base"}, {Role: "user", Content: "question"}}
+	first := withSelectedSkills(messages, skills)
+	second := withSelectedSkills(messages, selectedSkillMessages([]string{"data-understanding"}))
+	if len(messages) != 2 || len(first) != 3 || len(second) != 3 || strings.Contains(second[1].Content, "[Selected Agent Skill: ml-method-selection") {
+		t.Fatal("skills accumulated in history")
+	}
+	for _, tool := range autonomyTools(tools, true) {
+		if strings.HasPrefix(tool.Function.Name, "ask_o11y_") {
+			t.Fatal("publication exposed local autonomy tools")
+		}
+	}
+}
+
+func TestAutonomyScopeBoundaries(t *testing.T) {
+	loop := NewAgentLoop(nil, nil, log.DefaultLogger)
+	compute := "sandbox-analysis_profile_dataset"
+	newRequest := func() LoopRequest {
+		return LoopRequest{OrgID: "1", UserID: "u", SessionID: "s", MaxIterations: 4,
+			autonomy: &analysisAutonomy{catalog: []mcp.Tool{{Name: compute}, {Name: "sandbox-analysis_execute_ml_contract"}}, frames: map[string]string{}},
+			RegisterApproval: func(_ context.Context, a ApprovalRequestEvent) (ApprovalWaitFunc, error) {
+				return func(context.Context) (ApprovalResolvedEvent, error) {
+					return ApprovalResolvedEvent{ApprovalID: a.ApprovalID, Decision: "approved"}, nil
+				}, nil
+			},
+		}
+	}
+	args := `{"frame_ref":"frame","purpose":"Explain the observed change","tools":["sandbox-analysis_profile_dataset","sandbox-analysis_execute_ml_contract"],"max_calls":2}`
+	approve := func(req LoopRequest) (bool, string) {
+		_, failed, kind := loop.approveAnalysisScope(context.Background(), make(chan SSEEvent, 10), autonomyCall(approveAnalysisScopeTool, args), req)
+		return failed, kind
+	}
+	req := newRequest()
+	if failed, _ := approve(req); !failed {
+		t.Fatal("invented frame acquired approval")
+	}
+	query := autonomyCall("grafana-query_execute_planned_query", `{"plan_ref":"plan"}`)
+	req.autonomy.observeFrame(query, `{"ok":false,"refs":{"frame_ref":"frame"}}`, false)
+	if len(req.autonomy.frames) != 0 {
+		t.Fatal("failed result became authority")
+	}
+	req.autonomy.observeFrame(query, `{"ok":true,"refs":{"frame_ref":"frame"}}`, false)
+	if failed, kind := approve(req); failed {
+		t.Fatalf("scope approval: %s", kind)
+	}
+	for _, tc := range []ToolCall{
+		autonomyCall(compute, `{"frame_ref":"other"}`),
+		autonomyCall(compute, `{"frame_ref":"frame","_server_context":{}}`),
+		autonomyCall("sandbox-analysis_execute_python_analysis", `{"frame_ref":"frame","python_code":"print(1)"}`),
+		autonomyCall("sandbox-analysis_execute_ml_contract", `{"frame_ref":"frame","contract_ref":"another-plan"}`),
+		autonomyCall("mcp-grafana_update_dashboard", `{"frame_ref":"frame"}`),
+		autonomyCall("grafana-query_execute_planned_query", `{"plan_ref":"plan"}`),
+	} {
+		if req.autonomy.consumeScope(tc, req) {
+			t.Fatalf("scope accepted forbidden call %s", tc.Function.Name)
+		}
+	}
+	foreign := req
+	foreign.SessionID = "other"
+	valid := autonomyCall(compute, `{"frame_ref":"frame"}`)
+	if req.autonomy.consumeScope(valid, foreign) {
+		t.Fatal("scope crossed sessions")
+	}
+	if !req.autonomy.consumeScope(valid, req) || !req.autonomy.consumeScope(autonomyCall("sandbox-analysis_execute_ml_contract", `{"frame_ref":"frame","contract_ref":"plan"}`), req) || req.autonomy.consumeScope(valid, req) {
+		t.Fatal("call budget or exact ML plan not enforced")
+	}
+	fresh := newRequest()
+	if fresh.autonomy.consumeScope(valid, fresh) {
+		t.Fatal("scope survived into a new run")
+	}
+	for _, decision := range []string{"rejected", "approved-with-wrong-id"} {
