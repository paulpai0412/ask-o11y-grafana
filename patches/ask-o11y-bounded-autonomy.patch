+package agent
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"consensys-asko11y-app/pkg/mcp"
+	"github.com/grafana/grafana-plugin-sdk-go/backend/log"
+)
+
+func TestAutonomyScopeReplayAndPythonDenied(t *testing.T) {
+	loop := NewAgentLoop(nil, nil, log.DefaultLogger)
+	cache := map[string]ApprovalResolvedEvent{}
+	decisions := 0
+	req := LoopRequest{OrgID: "1", UserID: "u", SessionID: "s", MaxIterations: 5,
+		autonomy: &analysisAutonomy{catalog: []mcp.Tool{{Name: "sandbox-analysis_profile_dataset"}, {Name: "sandbox-analysis_execute_python_analysis"}}, frames: map[string]string{"frame-A": "plan-A", "frame-B": "plan-B"}},
+		RegisterApproval: func(_ context.Context, a ApprovalRequestEvent) (ApprovalWaitFunc, error) {
+			if previous, ok := cache[a.ApprovalID]; ok {
+				return func(context.Context) (ApprovalResolvedEvent, error) { return previous, nil }, nil
+			}
+			decisions++
+			decision := "rejected"
+			if decisions == 1 {
+				decision = "approved"
+			}
+			return func(context.Context) (ApprovalResolvedEvent, error) {
+				r := ApprovalResolvedEvent{ApprovalID: a.ApprovalID, Decision: decision}
+				cache[a.ApprovalID] = r
+				return r, nil
+			}, nil
+		},
+	}
+	for i, frame := range []string{"frame-A", "frame-B"} {
+		call := autonomyCall(approveAnalysisScopeTool, fmt.Sprintf(`{"frame_ref":%q,"purpose":"investigate","tools":["sandbox-analysis_profile_dataset"],"max_calls":%d}`, frame, i+1))
+		_, failed, _ := loop.approveAnalysisScope(context.Background(), make(chan SSEEvent, 8), call, req)
+		if (i == 0 && failed) || (i == 1 && (!failed || req.autonomy.scope != nil)) {
+			t.Fatal("reused model ID replayed an approval for changed frame/budget")
+		}
+	}
+	if decisions != 2 {
+		t.Fatalf("new proposal did not obtain a new decision: %d", decisions)
+	}
+	_, failed, _ := loop.approveAnalysisScope(context.Background(), make(chan SSEEvent, 8), autonomyCall(approveAnalysisScopeTool, `{"frame_ref":"frame-A","purpose":"investigate","tools":["sandbox-analysis_execute_python_analysis"],"max_calls":2}`), req)
+	if !failed || decisions != 2 {
+		t.Fatal("free-form Python entered reusable scope")
+	}
+	for _, args := range []string{
+		`{"frame_ref":"frame-A","purpose":"investigate","tools":["sandbox-analysis_profile_dataset"],"max_calls":6}`,
+		`{"frame_ref":"frame-A","purpose":"investigate","tools":["sandbox-analysis_profile_dataset"],"max_calls":0}`,
+		`{"frame_ref":"frame-A","purpose":"investigate","tools":["sandbox-analysis_profile_dataset"],"max_calls":2,"remaining":99}`,
+	} {
+		if _, failed, _ := loop.approveAnalysisScope(context.Background(), make(chan SSEEvent, 8), autonomyCall(approveAnalysisScopeTool, args), req); !failed {
+			t.Fatalf("invalid scope accepted: %s", args)
+		}
+	}
+}
+
+func TestAutonomyPythonNeverScopeEligible(t *testing.T) {
+	if scopeTool("sandbox-analysis_execute_python_analysis") {
+		t.Fatal("free-form Python cannot attest the unchanged ML contract and must remain exact-approved")
+	}
+}
+
+func TestAutonomyTruncationKeepsReplacementSkill(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		calls++
+		message := Message{Role: "assistant"}
+		switch calls {
+		case 1:
+			message.ToolCalls = []ToolCall{autonomyCall(selectCapabilitiesTool, `{"tools":[],"skills":["ml-method-selection"]}`)}
+		case 2:
+			message.ToolCalls = []ToolCall{autonomyCall(selectCapabilitiesTool, `{"tools":`)}
+		case 3:
+			if !strings.Contains(string(body), truncatedToolCallNudge) || !strings.Contains(string(body), "[Selected Agent Skill: ml-method-selection") {
+				t.Error("truncation nudge lost replacement skill")
+			}
+			message.Content = "No further evidence available."
+		default:
+			t.Error("unexpected extra LLM call")
+		}
+		respondAsStream(w, ChatCompletionResponse{Choices: []Choice{{Message: message, FinishReason: "stop"}}})
+	}))
+	defer server.Close()
+	proxy := mcp.NewProxy(context.Background(), log.DefaultLogger)
+	defer proxy.Close()
+	loop := NewAgentLoop(NewLLMClient(log.DefaultLogger, server.Client()), proxy, log.DefaultLogger)
+	events := make(chan SSEEvent, 32)
+	loop.Run(context.Background(), LoopRequest{SystemPrompt: "sys", Messages: []Message{{Role: "user", Content: "Analyze"}}, GrafanaURL: server.URL, UserRole: "Admin", MaxIterations: 4}, events)
+	if calls != 3 {
+		t.Fatalf("calls=%d", calls)
+	}
+}
diff --git a/pkg/agent/analysis_autonomy_test.go b/pkg/agent/analysis_autonomy_test.go
