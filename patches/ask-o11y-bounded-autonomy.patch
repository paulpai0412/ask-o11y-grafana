new file mode 100644
index 0000000..a398ed3
--- /dev/null
+++ b/pkg/agent/analysis_autonomy.go
@@ -0,0 +1,280 @@
+package agent
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"time"
+
+	"consensys-asko11y-app/pkg/mcp"
+)
+
+const selectCapabilitiesTool = "ask_o11y_select_capabilities"
+const approveAnalysisScopeTool = "ask_o11y_approve_analysis_scope"
+
+// Broker keys must never come from a model-provided ToolCall.ID. Even an
+// identical proposal needs a fresh user decision when registering a new grant.
+func hostApprovalID() string { return "approval_" + rand.Text() }
+
+// Run-local only: never serialized into history, accepted from model input or
+// restored from a tool-wide grant. A resumed/new run must obtain new approval.
+type analysisAutonomy struct {
+	catalog []mcp.Tool
+	frames  map[string]string // successful current-run frame -> exact query plan
+	scope   *analysisScope
+}
+
+type analysisScope struct {
+	FrameRef   string   `json:"frame_ref"`
+	Purpose    string   `json:"purpose"`
+	Tools      []string `json:"tools"`
+	MaxCalls   int      `json:"max_calls"`
+	planRef    string
+	remaining  int
+	approvalID string
+	actor      [3]string
+}
+
+func scopeTool(name string) bool {
+	switch name {
+	case "sandbox-analysis_profile_dataset", "sandbox-analysis_execute_ml_contract":
+		return true
+	}
+	return false
+}
+
+func hasTool(tools []mcp.Tool, name string) bool {
+	for _, tool := range tools {
+		if tool.Name == name {
+			return true
+		}
+	}
+	return false
+}
+
+func autonomyTools(tools []mcp.Tool, publication bool) []OpenAITool {
+	out := ConvertMCPToolsToOpenAI(tools)
+	if publication {
+		return out
+	}
+	out = append(out, OpenAITool{Type: "function", Function: OpenAIFunction{
+		Name:        selectCapabilitiesTool,
+		Description: "Discover or replace active tools/skills when evidence reveals a capability gap. Empty arguments return the authorized catalog. Nonempty tools/skills replace the selection; use exact catalog names. This changes availability, never permissions, approval, or publication state. No fixed workflow or extra planner call.",
+		Parameters: map[string]interface{}{"type": "object", "additionalProperties": false, "properties": map[string]interface{}{
+			"tools":  map[string]interface{}{"type": "array", "maxItems": maxSelectedTools, "uniqueItems": true, "items": map[string]interface{}{"type": "string"}},
+			"skills": map[string]interface{}{"type": "array", "maxItems": maxSelectedSkills, "uniqueItems": true, "items": map[string]interface{}{"type": "string"}},
+		}},
+	}})
+	out = append(out, OpenAITool{Type: "function", Function: OpenAIFunction{
+		Name:        approveAnalysisScopeTool,
+		Description: "Request explicit user approval for bounded autonomous compute on one successful current-run frame. Select exact supported compute tools and a call budget. Allows supported deterministic compute on that frame and unchanged ML contract. Free-form Python always needs its own exact approval because its semantic contract cannot be verified. No other dataset, query, write, publication or permission. Failed attempts consume budget; the scope expires at run end. Empty tools revokes an existing scope without granting anything. Never required for ordinary exact-call approval.",
+		Parameters: map[string]interface{}{"type": "object", "additionalProperties": false, "required": []string{"frame_ref", "purpose", "tools", "max_calls"}, "properties": map[string]interface{}{
+			"frame_ref": map[string]interface{}{"type": "string"}, "purpose": map[string]interface{}{"type": "string", "minLength": 1, "maxLength": 1000},
+			"tools":     map[string]interface{}{"type": "array", "uniqueItems": true, "items": map[string]interface{}{"type": "string", "enum": []string{"sandbox-analysis_profile_dataset", "sandbox-analysis_execute_ml_contract"}}},
+			"max_calls": map[string]interface{}{"type": "integer", "minimum": 1},
+		}},
+	}})
+	return out
+}
+
+func decodeAutonomyArgs(raw string, value interface{}) error {
+	if !strings.HasPrefix(strings.TrimSpace(raw), "{") || !json.Valid([]byte(raw)) {
+		return fmt.Errorf("arguments must be one JSON object")
+	}
+	decoder := json.NewDecoder(strings.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	return decoder.Decode(value)
+}
+
+func (s *analysisAutonomy) selectCapabilities(raw string, req LoopRequest) ([]mcp.Tool, []Message, string, error) {
+	var selection struct {
+		Tools  []string `json:"tools"`
+		Skills []string `json:"skills"`
+	}
+	if err := decodeAutonomyArgs(raw, &selection); err != nil {
+		return nil, nil, "", err
+	}
+	if selection.Tools == nil && selection.Skills == nil {
+		type entry struct {
+			Name        string `json:"name"`
+			Description string `json:"description"`
+		}
+		tools, skills := []entry{}, []entry{}
+		for _, tool := range s.catalog {
+			tools = append(tools, entry{tool.Name, truncateWhitespace(tool.Description, 300)})
+		}
+		for _, skill := range availableAgentSkills() {
+			skills = append(skills, entry{skill.Name, skill.Description})
+		}
+		body, _ := json.Marshal(map[string]interface{}{"tools": tools, "skills": skills, "max_tools": maxSelectedTools, "max_skills": maxSelectedSkills})
+		return nil, nil, string(body), nil
+	}
+	if selection.Tools == nil || selection.Skills == nil || len(selection.Tools) > maxSelectedTools || len(selection.Skills) > maxSelectedSkills {
+		return nil, nil, "", fmt.Errorf("replacement requires both tools and skills arrays within existing limits")
+	}
+	selected := []mcp.Tool{}
+	seen := map[string]bool{}
+	for _, name := range selection.Tools {
+		if seen[name] || !hasTool(s.catalog, name) {
+			return nil, nil, "", fmt.Errorf("unknown, duplicate or unauthorized tool: %s", name)
+		}
+		seen[name] = true
+		for _, family := range []string{"loki", "prometheus", "tempo", "pyroscope"} {
+			lower := strings.ToLower(name)
+			if (strings.Contains(lower, "_"+family+"_") || strings.HasSuffix(lower, "_"+family)) && !conversationSupportsDatasourceFamily(req.Messages, family) {
+				return nil, nil, "", fmt.Errorf("datasource family lacks existing conversation authorization: %s", family)
+			}
+		}
+		for _, tool := range s.catalog {
+			if tool.Name == name {
+				selected = append(selected, tool)
+				break
+			}
+		}
+	}
+	seen = map[string]bool{}
+	for _, name := range selection.Skills {
+		known := false
+		for _, skill := range availableAgentSkills() {
+			known = known || skill.Name == name
+		}
+		if !known || seen[name] {
+			return nil, nil, "", fmt.Errorf("unknown or duplicate skill: %s", name)
+		}
+		seen[name] = true
+	}
+	body, _ := json.Marshal(map[string]interface{}{"ok": true, "tools": selection.Tools, "skills": selection.Skills})
+	return selected, selectedSkillMessages(selection.Skills), string(body), nil
+}
+
+func withSelectedSkills(messages, skills []Message) []Message {
+	if len(messages) == 0 || len(skills) == 0 {
+		return messages
+	}
+	out := make([]Message, 0, len(messages)+len(skills))
+	out = append(out, messages[0])
+	out = append(out, skills...)
+	return append(out, messages[1:]...)
+}
+
+func (s *analysisAutonomy) observeFrame(tc ToolCall, content string, isError bool) {
+	if isError || tc.Function.Name != "grafana-query_execute_planned_query" {
+		return
+	}
+	var args struct {
+		PlanRef string `json:"plan_ref"`
+	}
+	var result struct {
+		OK       bool   `json:"ok"`
+		FrameRef string `json:"frame_ref"`
+		Refs     struct {
+			FrameRef string `json:"frame_ref"`
+		} `json:"refs"`
+	}
+	if json.Unmarshal([]byte(tc.Function.Arguments), &args) != nil || json.Unmarshal([]byte(content), &result) != nil || !result.OK || args.PlanRef == "" {
+		return
+	}
+	frame := result.FrameRef
+	if frame == "" {
+		frame = result.Refs.FrameRef
+	}
+	if frame != "" {
+		s.frames[frame] = args.PlanRef
+	}
+}
+
+func (a *AgentLoop) approveAnalysisScope(ctx context.Context, events chan<- SSEEvent, tc ToolCall, req LoopRequest) (string, bool, string) {
+	s := req.autonomy
+	if s == nil || req.ForceGrafanaPublication {
+		return "Scope approval unavailable", true, "approval_required"
+	}
+	// Any attempted replacement/revocation invalidates the previous scope.
+	s.scope = nil
+	var proposal analysisScope
+	if err := decodeAutonomyArgs(tc.Function.Arguments, &proposal); err != nil {
+		return err.Error(), true, "tool"
+	}
+	if len(proposal.Tools) == 0 {
+		return `{"ok":true,"scope_revoked":true}`, false, ""
+	}
+	plan := s.frames[proposal.FrameRef]
+	if plan == "" || req.OrgID == "" || req.UserID == "" || req.SessionID == "" || tc.ID == "" {
+		return "Scope requires authenticated actor/session and a successful current-run query frame", true, "approval_required"
+	}
+	limit := req.MaxIterations
+	if limit <= 0 {
+		limit = defaultMaxIterations
+	}
+	if proposal.MaxCalls < 1 || proposal.MaxCalls > limit || strings.TrimSpace(proposal.Purpose) == "" || len(proposal.Purpose) > 1000 {
+		return "Scope needs a purpose and positive call budget no greater than the run iteration limit", true, "tool"
+	}
+	seen := map[string]bool{}
+	for _, name := range proposal.Tools {
+		if !scopeTool(name) || !hasTool(s.catalog, name) || seen[name] {
+			return "Scope contains duplicate, unauthorized or non-compute tool", true, "approval_required"
+		}
+		seen[name] = true
+	}
+	if req.RegisterApproval == nil {
+		return "User approval is required for an analysis scope", true, "approval_required"
+	}
+	approval := ApprovalRequestEvent{ApprovalID: hostApprovalID(), ToolCallID: tc.ID, ToolName: approveAnalysisScopeTool, Risk: "write", Arguments: tc.Function.Arguments,
+		Reason: fmt.Sprintf("Authorize at most %d compute attempts on this exact frame and originating plan %s during this run. Only the listed deterministic operations are covered; free-form Python, new data, changed ML contracts, writes and publication require separate approval. Existing sandbox/resource and data guards still apply.", proposal.MaxCalls, plan)}
+	wait, err := req.RegisterApproval(ctx, approval)
+	if err != nil || wait == nil {
+		return "Unable to register scope approval", true, "approval_required"
+	}
+	a.send(ctx, events, SSEEvent{Type: "approval_request", Data: approval})
+	resolved, err := wait(ctx)
+	if err != nil || ctx.Err() != nil {
+		return "Scope approval interrupted; no scope granted", true, "approval_required"
+	}
+	if resolved.ResolvedAt == "" {
+		resolved.ResolvedAt = time.Now().UTC().Format(time.RFC3339)
+	}
+	a.send(ctx, events, SSEEvent{Type: "approval_resolved", Data: resolved})
+	if resolved.Decision != "approved" || resolved.ApprovalID != approval.ApprovalID {
+		return "Scope was not approved for this request", true, "approval_denied"
+	}
+	proposal.planRef = plan
+	proposal.remaining = proposal.MaxCalls
+	proposal.approvalID = approval.ApprovalID
+	proposal.actor = [3]string{req.OrgID, req.UserID, req.SessionID}
+	s.scope = &proposal
+	body, _ := json.Marshal(map[string]interface{}{"ok": true, "scope_approval_id": approval.ApprovalID, "frame_ref": proposal.FrameRef, "remaining_calls": proposal.remaining, "expires": "run_end"})
+	return string(body), false, ""
+}
+
+func (s *analysisAutonomy) consumeScope(tc ToolCall, req LoopRequest) bool {
+	if s == nil || s.scope == nil || req.ForceGrafanaPublication {
+		return false
+	}
+	grant := s.scope
+	if grant.remaining <= 0 || grant.actor != [3]string{req.OrgID, req.UserID, req.SessionID} || !containsString(grant.Tools, tc.Function.Name) {
+		return false
+	}
+	var args map[string]interface{}
+	if json.Unmarshal([]byte(tc.Function.Arguments), &args) != nil || stringArg(args["frame_ref"]) != grant.FrameRef {
+		return false
+	}
+	allowed := map[string]bool{"frame_ref": true, "seed": true}
+	switch tc.Function.Name {
+	case "sandbox-analysis_execute_ml_contract":
+		allowed["contract_ref"] = true
+		if stringArg(args["contract_ref"]) != grant.planRef {
+			return false
+		}
+	case "sandbox-analysis_profile_dataset":
+	default:
+		return false
+	}
+	for key := range args {
+		if !allowed[key] {
+			return false
+		}
+	}
+	grant.remaining-- // failed/indeterminate attempts also consume budget, before dispatch
+	return true
+}
