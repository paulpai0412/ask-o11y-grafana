+// A scripted LLM drives the real Run -> approval -> MCP seam. No live model or data.
+func TestAutonomyRunReselectScopeAndBudget(t *testing.T) {
+	ctx := context.Background()
+	computeCalls, registrations := 0, 0
+	mcpServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var rpc struct {
+			Params struct {
+				Name string `json:"name"`
+			} `json:"params"`
+		}
+		var result interface{}
+		switch r.URL.Path {
+		case "/mcp/list-tools":
+			result = map[string]interface{}{"tools": []map[string]interface{}{{"name": "execute_planned_query", "inputSchema": map[string]string{"type": "object"}}, {"name": "profile_dataset", "inputSchema": map[string]string{"type": "object"}}}}
+		case "/mcp/call-tool":
+			if err := json.NewDecoder(r.Body).Decode(&rpc); err != nil {
+				t.Error(err)
+				return
+			}
+			text := `{"ok":true,"refs":{"frame_ref":"frame"}}`
+			if rpc.Params.Name == "profile_dataset" {
+				computeCalls++
+				text = `{"ok":true,"step":"profile_dataset","refs":{"execution_ref":"result"}}`
+			}
+			result = map[string]interface{}{"content": []map[string]string{{"type": "text", "text": text}}}
+		default:
+			result = map[string]interface{}{}
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(result)
+	}))
+	defer mcpServer.Close()
+	proxy := mcp.NewProxy(ctx, log.DefaultLogger)
+	defer proxy.Close()
+	configs := []mcp.ServerConfig{{ID: "grafana-query", URL: mcpServer.URL, Type: "standard", Enabled: true}, {ID: "sandbox-analysis", URL: mcpServer.URL, Type: "standard", Enabled: true}}
+	for _, config := range configs {
+		if err := proxy.EnsureServer(config); err != nil {
+			t.Fatal(err)
+		}
+	}
+	steps := []ToolCall{
+		autonomyCall("grafana-query_execute_planned_query", `{"plan_ref":"plan"}`),
+		autonomyCall(selectCapabilitiesTool, `{"tools":["sandbox-analysis_profile_dataset"],"skills":["ml-method-selection"]}`),
+		autonomyCall(approveAnalysisScopeTool, `{"frame_ref":"frame","purpose":"Explain change","tools":["sandbox-analysis_profile_dataset"],"max_calls":2}`),
+		autonomyCall("sandbox-analysis_profile_dataset", `{"frame_ref":"frame","seed":1}`),
+		autonomyCall("sandbox-analysis_profile_dataset", `{"frame_ref":"frame","seed":2}`),
+		autonomyCall("sandbox-analysis_profile_dataset", `{"frame_ref":"frame","seed":3}`),
+	}
+	llmCalls := 0
+	llmServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		i := llmCalls
+		llmCalls++
+		message := Message{Role: "assistant", Content: "Evidence-based answer"}
+		if i == 0 {
+			message.Content = `{"tools":["grafana-query_execute_planned_query"],"skills":["data-understanding"]}`
+		} else if i <= len(steps) {
+			step := steps[i-1]
+			step.ID = "provider-reused-id" // never safe to use as a broker key
+			message.Content = ""
+			message.ToolCalls = []ToolCall{step}
+		}
+		if i >= 3 && (!strings.Contains(string(body), "[Selected Agent Skill: ml-method-selection") || strings.Contains(string(body), "[Selected Agent Skill: data-understanding")) {
+			t.Error("replacement skill did not replace prior skill in next request")
+		}
+		if i == len(steps) && !strings.Contains(string(body), nearLimitWarning) {
+			t.Error("expected near-limit nudge after reselection")
+		}
+		respondAsStream(w, ChatCompletionResponse{Choices: []Choice{{Message: message, FinishReason: "stop"}}})
+	}))
+	defer llmServer.Close()
+	loop := NewAgentLoop(NewLLMClient(log.DefaultLogger, llmServer.Client()), proxy, log.DefaultLogger)
+	events := make(chan SSEEvent, 128)
+	cached := map[string]ApprovalResolvedEvent{} // same replay behavior as both production brokers
+	req := LoopRequest{SystemPrompt: "sys", Messages: []Message{{Role: "user", Content: "Analyze the change"}}, GrafanaURL: llmServer.URL, UserRole: "Admin", OrgID: "1", UserID: "u", SessionID: "s", MCPServers: configs, MaxIterations: len(steps) + 1,
+		RegisterApproval: func(_ context.Context, a ApprovalRequestEvent) (ApprovalWaitFunc, error) {
+			if previous, ok := cached[a.ApprovalID]; ok {
+				return func(context.Context) (ApprovalResolvedEvent, error) { return previous, nil }, nil
+			}
+			registrations++
+			decision := "approved"
+			if registrations > 2 {
+				decision = "rejected"
+			}
+			return func(context.Context) (ApprovalResolvedEvent, error) {
+				resolved := ApprovalResolvedEvent{ApprovalID: a.ApprovalID, Decision: decision}
+				cached[a.ApprovalID] = resolved
+				return resolved, nil
+			}, nil
+		},
+	}
+	loop.Run(ctx, req, events)
+	all := collectEvents(events)
+	ids := map[string]bool{}
+	for _, event := range all {
+		if event.Type == "approval_request" {
+			id := event.Data.(ApprovalRequestEvent).ApprovalID
+			if ids[id] || id == "provider-reused-id" {
+				t.Fatal("approval trace/broker identity reused")
+			}
+			ids[id] = true
+		}
+	}
+	if computeCalls != 2 || registrations != 3 || llmCalls != len(steps)+2 {
+		t.Fatalf("compute=%d approval=%d llm=%d; want 2,3,%d", computeCalls, registrations, llmCalls, len(steps)+2)
+	}
+	if all[len(all)-1].Type != "done" {
+		t.Fatal("run did not finish")
+	}
+}
