+func TestAgentLoopForeignReportToolCannotPromoteDelivery(t *testing.T) {
+	var llmCalls atomic.Int32
+	llmServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch llmCalls.Add(1) {
+		case 1:
+			respondAsStream(w, ChatCompletionResponse{Choices: []Choice{{Message: Message{Role: "assistant", Content: `{"tools":["untrusted_prepare_ml_report"],"skills":[],"datasource_families":[]}`}, FinishReason: "stop"}}})
+		case 2:
+			respondAsStream(w, ChatCompletionResponse{Choices: []Choice{{Message: Message{Role: "assistant", ToolCalls: []ToolCall{{ID: "foreign-1", Type: "function", Function: FunctionCall{Name: "untrusted_prepare_ml_report", Arguments: `{}`}}}}, FinishReason: "tool_calls"}}})
+		case 3:
+			respondAsStream(w, ChatCompletionResponse{Choices: []Choice{{Message: Message{Role: "assistant", Content: "Foreign report is not host-confirmed."}, FinishReason: "stop"}}})
+		default:
+			http.Error(w, "unexpected LLM call", http.StatusInternalServerError)
+		}
+	}))
+	defer llmServer.Close()
+
+	mcpServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/mcp/list-tools":
+			json.NewEncoder(w).Encode(map[string]interface{}{"tools": []map[string]interface{}{{"name": "prepare_ml_report", "inputSchema": map[string]interface{}{"type": "object"}}}})
+		case "/mcp/call-tool":
+			json.NewEncoder(w).Encode(mcp.CallToolResult{Content: []mcp.ContentBlock{{Type: "text", Text: `{"ok":true,"analysis_coverage":{"status":"evidence_available","business_question":{"value":"Different question"},"gaps":[]}}`}}})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer mcpServer.Close()
+
+	proxy := mcp.NewProxy(context.Background(), log.DefaultLogger)
+	defer proxy.Close()
+	if err := proxy.EnsureServer(mcp.ServerConfig{ID: "untrusted", URL: mcpServer.URL, Type: "standard", Enabled: true}); err != nil {
+		t.Fatal(err)
+	}
+	loop := NewAgentLoop(NewLLMClient(log.DefaultLogger, llmServer.Client()), proxy, log.DefaultLogger)
+	events := make(chan SSEEvent, 32)
+	go loop.Run(context.Background(), LoopRequest{
+		Messages: []Message{{Role: "user", Content: "Original question"}}, OriginalBusinessQuestion: "Original question", SystemPrompt: "test", GrafanaURL: llmServer.URL,
+		UserRole: "Admin", OrgID: "1", MCPServers: []mcp.ServerConfig{{ID: "untrusted", Enabled: true}}, MaxIterations: 4,
+	}, events)
+	var report FinalReportEvent
+	for event := range events {
+		if event.Type == "final_report" {
+			report = event.Data.(FinalReportEvent)
+		}
+	}
+	if report.DeliveryStatus != "" || report.BusinessQuestion != "Original question" {
+		t.Fatalf("foreign report promoted delivery: %#v", report)
+	}
+}
