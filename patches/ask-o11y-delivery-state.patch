+package agent
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// deliveryState is host-owned state derived only from known MCP contracts. It
+// deliberately does not infer coverage from assistant prose or arbitrary JSON.
+type deliveryState struct {
+	originalQuestion string
+	planQuestion     string
+	planRef          string
+	delivery         string
+	gaps             []string
+	writerStatus     string
+	profileOnly      bool
+	explicitPartial  bool
+
+	// resolvedTools is populated from the proxy's actual tools/list response.
+	// It is an additional guard: a foreign server cannot claim a contract merely
+	// by choosing a similar short name.
+	resolvedTools      map[string]struct{}
+	reportManifestRef  string
+	reportContextRef   string
+	reportExecutionRef string
+	reportPlanRef      string
+}
+
+func newDeliveryState(originalQuestion string) *deliveryState {
+	return &deliveryState{originalQuestion: strings.TrimSpace(originalQuestion), resolvedTools: make(map[string]struct{})}
+}
+
+func (s *deliveryState) setResolvedToolNames(names []string) {
+	if s == nil {
+		return
+	}
+	for _, name := range names {
+		if strings.TrimSpace(name) != "" {
+			s.resolvedTools[name] = struct{}{}
+		}
+	}
+}
+
+// observe is retained for package-level callers and tests that already have a
+// normalized tool result. The loop uses observeCall so report refs can be
+// checked against the actual arguments sent to the producer.
+func (s *deliveryState) observe(toolName, content string, isError bool) {
+	s.observeCall(toolName, "", content, isError)
+}
+
+func (s *deliveryState) observeCall(toolName, arguments, content string, isError bool) {
+	if s == nil || isError || !s.acceptsTool(toolName) {
+		return
+	}
+	payload := make(map[string]interface{})
+	if err := json.Unmarshal([]byte(content), &payload); err != nil || payload["ok"] != true {
+		return
+	}
+
+	if toolName == "mcp-grafana_update_dashboard" {
+		s.writerStatus = "succeeded"
+		return
+	}
+
+	if toolName == "data-query-planner_plan_query" {
+		if s.planQuestion == "" {
+			s.planQuestion = businessQuestion(payload["business_question"])
+			if s.planQuestion == "" {
+				s.planQuestion = businessQuestion(payload["plan"])
+			}
+		}
+		if planRef := firstRef(payload, "plan_ref"); planRef != "" && planRef != s.planRef {
+			s.planRef = planRef
+			s.reportManifestRef, s.reportContextRef, s.reportExecutionRef, s.reportPlanRef = "", "", "", ""
+		}
+		return
+	}
+
+	knownCoverageTool := toolName == "sandbox-analysis_execute_python_analysis" ||
+		toolName == "sandbox-analysis_profile_dataset" ||
+		toolName == "artifact-bridge_prepare_ml_report" ||
+		toolName == "artifact-bridge_compose_ml_dashboard"
+	if !knownCoverageTool {
+		return
+	}
+
+	// A successful Sandbox producer establishes the only report lineage that a
+	// later report tool may use. This rejects stale report refs from a prior run.
+	if toolName == "sandbox-analysis_execute_python_analysis" {
+		s.recordExecutionRefs(payload)
+	}
+
+	coverage := coverageObject(payload)
+	if coverage == nil {
+		if toolName == "sandbox-analysis_profile_dataset" {
+			s.profileOnly = true
+		}
+		return
+	}
+
+	status, _ := coverage["status"].(string)
+	bound := s.coverageBound(toolName, arguments, payload, status)
+	// A bare not_assessed result is useful as an unresolved host warning, but
+	// it must not import a question or promote an unrelated report. All other
+	// report statuses require current-run report/ref lineage.
+	explicitPartial, _ := payload["delivery_status"].(string)
+	if !bound && status != "not_assessed" && !(explicitPartial == "partial" && s.planRef == "" && s.reportContextRef == "") {
+		return
+	}
+
+	if bound && s.planQuestion == "" {
+		s.planQuestion = businessQuestion(coverage["business_question"])
+		if s.planQuestion == "" {
+			if evidence, ok := payload["evidence"].(map[string]interface{}); ok {
+				s.planQuestion = businessQuestion(evidence["business_question"])
+			}
+		}
+		if s.planQuestion == "" {
+			s.planQuestion = businessQuestion(payload["business_question"])
+		}
+	}
+	for _, gap := range coverageGaps(coverage["gaps"]) {
+		s.addGap(gap)
+	}
+
+	if explicit, ok := payload["delivery_status"].(string); ok && explicit == "partial" {
+		s.explicitPartial = true
+		s.delivery = "partial"
+		return
+	}
+	switch status {
+	case "not_assessed":
+		if !s.explicitPartial {
+			s.delivery = "not_assessed"
+		}
+	case "incomplete":
+		if !s.explicitPartial && bound {
+			s.delivery = "partial"
+		}
+	case "evidence_available":
+		if !s.explicitPartial && bound {
+			s.delivery = "evidence_available"
+		}
+	}
+}
+
+func (s *deliveryState) acceptsTool(name string) bool {
+	if !trustedDeliveryToolName(name) {
+		return false
+	}
+	if len(s.resolvedTools) == 0 {
+		return true
+	}
+	_, ok := s.resolvedTools[name]
+	return ok
+}
+
+func trustedDeliveryToolName(name string) bool {
+	switch name {
+	case "data-query-planner_plan_query", "sandbox-analysis_execute_python_analysis", "sandbox-analysis_profile_dataset", "artifact-bridge_prepare_ml_report", "artifact-bridge_compose_ml_dashboard", "mcp-grafana_update_dashboard":
+		return true
+	default:
+		return false
+	}
+}
+
+func (s *deliveryState) recordExecutionRefs(payload map[string]interface{}) {
+	if refs := firstRef(payload, "report_manifest_ref", "report_context_ref"); refs != "" {
+		if strings.HasSuffix(refs, "/report-manifest") || strings.Contains(refs, "report-manifest") {
+			s.reportManifestRef = refs
+		} else {
+			s.reportExecutionRef = refs
+		}
+	}
+	if execution := firstRef(payload, "execution_ref"); execution != "" {
+		s.reportExecutionRef = execution
+	}
+}
+
+func (s *deliveryState) coverageBound(toolName, arguments string, payload map[string]interface{}, status string) bool {
+	args := map[string]interface{}{}
+	if arguments != "" {
+		_ = json.Unmarshal([]byte(arguments), &args)
+	}
+	planLineage := firstRef(payload, "plan_ref", "contract_ref")
+	if planLineage == "" {
+		planLineage = firstRefFrom(args, "plan_ref", "contract_ref")
+	}
+	if planLineage != "" && s.planRef != "" && planLineage != s.planRef {
+		return false
+	}
+	if status == "evidence_available" && s.planRef != "" && planLineage == "" && s.reportPlanRef != s.planRef {
+		return false
+	}
+
+	switch toolName {
+	case "artifact-bridge_prepare_ml_report":
+		manifest := firstRef(payload, "report_manifest_ref")
+		context := firstRef(payload, "report_context_ref")
+		if manifest == "" || context == "" || s.reportManifestRef == "" || manifest != s.reportManifestRef {
+			return false
+		}
+		if planLineage := firstRef(payload, "plan_ref", "contract_ref"); planLineage != "" {
+			if s.planRef != "" && planLineage != s.planRef {
+				return false
+			}
+			s.reportPlanRef = planLineage
+		}
+		s.reportContextRef = context
+		return true
+	case "artifact-bridge_compose_ml_dashboard":
+		context := firstRefFrom(args, "report_context_ref")
+		return context != "" && context == s.reportContextRef
+	default:
+		// Compute results may carry coverage directly. Evidence promotion still
+		// requires a report manifest emitted by this run.
+		return s.reportManifestRef != "" && status != "not_assessed"
+	}
+}
+
+func (s *deliveryState) addGap(gap string) {
+	gap = strings.TrimSpace(gap)
+	if gap == "" {
+		return
+	}
+	for _, existing := range s.gaps {
+		if existing == gap {
+			return
+		}
+	}
+	s.gaps = append(s.gaps, gap)
+}
+
+func (s *deliveryState) deliveryStatus() string {
+	if s == nil {
+		return ""
+	}
+	if s.delivery != "" {
+		return s.delivery
+	}
+	if s.profileOnly {
+		return "profile_only"
+	}
+	return ""
+}
+
+func (s *deliveryState) question() string {
+	if s == nil {
+		return ""
+	}
+	if s.planQuestion != "" {
+		return s.planQuestion
+	}
+	return s.originalQuestion
+}
+
+func (s *deliveryState) warning() string {
+	status := s.deliveryStatus()
+	if status == "" {
+		return ""
+	}
+	question := s.question()
+	var warning string
+	switch status {
+	case "profile_only":
+		warning = "Host delivery status: profile_only. This is a descriptive data profile, not an answer to an unrecorded analytical requirement."
+	case "evidence_available":
+		warning = "Host delivery status: evidence_available. Retained evidence is available, but this status does not assert scientific or operational completion."
+	default:
+		warning = fmt.Sprintf("Host delivery status: %s. Analytical completion is not established", status)
+		if question != "" {
+			warning += fmt.Sprintf(" for the requested question %q", question)
+		}
+		warning += "."
+	}
+	if len(s.gaps) > 0 {
+		warning += " Known gap: " + strings.Join(s.gaps, "; ")
+	}
+	return warning
+}
+
+func coverageObject(payload map[string]interface{}) map[string]interface{} {
+	if coverage, ok := payload["analysis_coverage"].(map[string]interface{}); ok {
+		return coverage
+	}
+	if evidence, ok := payload["evidence"].(map[string]interface{}); ok {
+		if coverage, ok := evidence["analysis_coverage"].(map[string]interface{}); ok {
+			return coverage
+		}
+	}
+	if report, ok := payload["report_context"].(map[string]interface{}); ok {
+		if coverage, ok := report["analysis_coverage"].(map[string]interface{}); ok {
+			return coverage
+		}
+	}
+	return nil
+}
+
+func firstRef(payload map[string]interface{}, keys ...string) string {
+	if ref := firstString(payload, keys...); ref != "" {
+		return ref
+	}
+	if refs, ok := payload["refs"].(map[string]interface{}); ok {
+		return firstString(refs, keys...)
+	}
+	if evidence, ok := payload["evidence"].(map[string]interface{}); ok {
+		if ref := firstString(evidence, keys...); ref != "" {
+			return ref
+		}
+		if refs, ok := evidence["refs"].(map[string]interface{}); ok {
+			return firstString(refs, keys...)
+		}
+	}
+	return ""
+}
+
+func firstRefFrom(payload map[string]interface{}, keys ...string) string {
+	return firstString(payload, keys...)
+}
+
+func firstString(payload map[string]interface{}, keys ...string) string {
+	for _, key := range keys {
+		if value, ok := payload[key].(string); ok && strings.TrimSpace(value) != "" {
+			return strings.TrimSpace(value)
+		}
+	}
+	return ""
+}
+
+func businessQuestion(value interface{}) string {
+	switch question := value.(type) {
+	case string:
+		return strings.TrimSpace(question)
+	case map[string]interface{}:
+		if value, ok := question["value"].(string); ok {
+			return strings.TrimSpace(value)
+		}
+		if value, ok := question["question"].(string); ok {
+			return strings.TrimSpace(value)
+		}
+	}
+	return ""
+}
+
+func coverageGaps(value interface{}) []string {
+	items, ok := value.([]interface{})
+	if !ok {
+		return nil
+	}
+	gaps := make([]string, 0, len(items))
+	for _, item := range items {
+		gap, ok := item.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		message, _ := gap["message"].(string)
+		code, _ := gap["code"].(string)
+		message = strings.TrimSpace(message)
+		code = strings.TrimSpace(code)
+		if message == "" {
+			message = code
+		} else if code != "" {
+			message = code + ": " + message
+		}
+		if message != "" {
+			gaps = append(gaps, message)
+		}
+	}
+	return gaps
+}
