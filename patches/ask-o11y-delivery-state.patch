+	if stale.deliveryStatus() != "" || stale.question() != "Confirmed question" {
+		t.Fatalf("stale report changed delivery state: %#v", stale)
+	}
+
+	mismatch := newDeliveryState("Original question")
+	mismatch.observe("data-query-planner_plan_query", `{"ok":true,"refs":{"plan_ref":"artifact://plan-1"},"business_question":"Confirmed question"}`, false)
+	mismatch.observe("sandbox-analysis_execute_python_analysis", `{"ok":true,"refs":{"report_manifest_ref":"artifact://new/report-manifest","execution_ref":"artifact://new/sandbox-execution"}}`, false)
+	mismatch.observe("artifact-bridge_prepare_ml_report", `{"ok":true,"refs":{"report_manifest_ref":"artifact://new/report-manifest","report_context_ref":"artifact://new/report-context"},"plan_ref":"artifact://plan-1","analysis_coverage":{"status":"not_assessed","business_question":{"value":"Confirmed question"}}}`, false)
+	mismatch.observeCall("artifact-bridge_compose_ml_dashboard", `{"report_context_ref":"artifact://other/report-context"}`, `{"ok":true,"evidence":{"analysis_coverage":{"status":"evidence_available","business_question":{"value":"Wrong question"}}}}`, false)
+	if mismatch.deliveryStatus() != "not_assessed" || mismatch.question() != "Confirmed question" {
+		t.Fatalf("mismatched report changed delivery state: %#v", mismatch)
+	}
+
+	same := newDeliveryState("Original question")
+	same.observe("data-query-planner_plan_query", `{"ok":true,"refs":{"plan_ref":"artifact://plan-1"},"business_question":"Confirmed question"}`, false)
+	same.observe("sandbox-analysis_execute_python_analysis", `{"ok":true,"refs":{"report_manifest_ref":"artifact://new/report-manifest","execution_ref":"artifact://new/sandbox-execution"}}`, false)
+	same.observe("artifact-bridge_prepare_ml_report", `{"ok":true,"refs":{"report_manifest_ref":"artifact://new/report-manifest","report_context_ref":"artifact://new/report-context"},"plan_ref":"artifact://plan-1","analysis_coverage":{"status":"not_assessed","business_question":{"value":"Confirmed question"}}}`, false)
+	same.observeCall("artifact-bridge_compose_ml_dashboard", `{"report_context_ref":"artifact://new/report-context"}`, `{"ok":true,"delivery_status":"standard","evidence":{"analysis_coverage":{"status":"evidence_available","business_question":{"value":"Confirmed question"},"gaps":[]}}}`, false)
+	if same.deliveryStatus() != "evidence_available" || same.question() != "Confirmed question" {
+		t.Fatalf("same-report evidence was not retained: %#v", same)
+	}
