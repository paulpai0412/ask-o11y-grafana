+func TestDashboardWriteIdentityCannotRedirectUIDGate(t *testing.T) {
+	t.Setenv("ASKO11Y_EFFECT_STORE", t.TempDir())
+	var calls atomic.Int32
+	loop := NewAgentLoop(nil, newDashboardBoundaryProxy(t, map[string]interface{}{}, "one", &calls), log.DefaultLogger)
+	for _, raw := range []string{
+		`{"dashboard":{"id":123,"panels":[]}}`,
+		`{"dashboard":{"uid":123,"panels":[]}}`,
+		`{"dashboard":{"uid":"one"},"uid":123}`,
+		`{"dashboard":{"uid":"one"},"operations":[{"path":"$.uid","value":"two"}]}`,
+		`{"dashboard":{"uid":"one"},"uid":"two"}`,
+		`{"id":123,"operations":[]}`,
+		`{"uid":"one","operations":[{"path":"$.uid","value":"two"}]}`,
+		`{"uid":"one","operations":[{"path":"$['id']","value":123}]}`,
+		`{"uid":"one","operations":[{"path":"$","value":{"uid":"two"}}]}`,
+		`{"uid":"one","operations":[{"path":"$.*","value":"two"}]}`,
+		`{"uid":"one","operations":[{"path":"$.panels[0]^['uid']","value":"two"}]}`,
+		`{"uid":"one","operations":[{"path":"$.panels[?(@.x == $.uid)]","value":"two"}]}`,
+	} {
+		var args map[string]interface{}
+		if err := json.Unmarshal([]byte(raw), &args); err != nil {
+			t.Fatal(err)
+		}
+		if err := normalizeDashboardWriteIdentity(args); err == nil {
+			t.Fatalf("identity redirect accepted: %s", raw)
+		}
+		if _, failed, _ := runDashboardBoundaryCall(t, loop, dashboardBoundaryRequest("session"), raw); !failed || calls.Load() != 0 {
+			t.Fatalf("identity redirect reached writer: %s", raw)
+		}
+	}
+	for _, path := range []string{"$.title", "$.panels/0", "$['panels'][0]", `$.tags[0]`, `$["panels"][0]`, `$.panels[*].gridPos.x`} {
+		args := map[string]interface{}{"uid": "one", "operations": []interface{}{map[string]interface{}{"path": path}}}
+		if err := normalizeDashboardWriteIdentity(args); err != nil {
+			t.Fatalf("native field rejected: %s: %v", path, err)
+		}
+	}
+	original := map[string]interface{}{"uid": "one", "id": float64(123), "panels": []interface{}{}}
+	args := map[string]interface{}{"dashboard": original}
+	if err := normalizeDashboardWriteIdentity(args); err != nil {
+		t.Fatal(err)
+	}
+	if _, exists := args["dashboard"].(map[string]interface{})["id"]; exists {
+		t.Fatal("numeric ID forwarded alongside UID")
+	}
+	if original["id"] != float64(123) {
+		t.Fatal("normalization mutated original dashboard")
+	}
+}
