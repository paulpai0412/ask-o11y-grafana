+func dashboardTargetUID(args map[string]interface{}) string {
+	if dashboard, ok := args["dashboard"].(map[string]interface{}); ok {
+		return dashboardUID(dashboard)
+	}
+	if uid, ok := args["uid"].(string); ok && strings.TrimSpace(uid) != "" {
+		return strings.TrimSpace(uid)
+	}
+	return ""
