+// reportDashboardProvenance is server-owned evidence that a composed report was
+// written to this Grafana UID. The org/UID key is the protection boundary;
+// actor/session are retained for audit and recovery context.
+type reportDashboardProvenance struct {
+	OrgID       string `json:"org_id"`
+	UID         string `json:"uid"`
+	ReportRef   string `json:"report_ref"`
+	ActorID     string `json:"actor_id"`
+	SessionID   string `json:"session_id"`
+	OperationID string `json:"operation_id,omitempty"`
+}
+
+type reportDashboardUIDReservation struct {
+	path  string
+	lock  *os.File
+	fresh bool
+}
+
+func reportDashboardUIDReservationPath(root, orgID, uid string) string {
+	key := sha256.Sum256([]byte(orgID + "\x00" + uid))
+	return filepath.Join(root, "report-dashboard-provenance", "locks", hex.EncodeToString(key[:]))
+}
+
+func prepareReportDashboardProvenanceRoot(root string) error {
+	if err := os.MkdirAll(root, 0700); err != nil {
+		return err
+	}
+	if err := os.Chmod(root, 0700); err != nil {
+		return err
+	}
+	provenanceRoot := filepath.Join(root, "report-dashboard-provenance")
+	if err := os.MkdirAll(provenanceRoot, 0700); err != nil {
+		return err
+	}
+	if err := os.Chmod(provenanceRoot, 0700); err != nil {
+		return err
+	}
+	// MkdirAll may have created several ancestors of a configured store path.
+	parent, err := filepath.Abs(root)
+	if err != nil {
+		return err
+	}
+	for {
+		if err := syncReceiptDirectory(parent); err != nil {
+			return err
+		}
+		next := filepath.Dir(parent)
+		if next == parent {
+			break
+		}
+		parent = next
+	}
+	locksRoot := filepath.Join(provenanceRoot, "locks")
+	if err := os.MkdirAll(locksRoot, 0700); err != nil {
+		return err
+	}
+	if err := os.Chmod(locksRoot, 0700); err != nil {
+		return err
+	}
+	return syncReceiptDirectory(provenanceRoot)
+}
+
+func reserveDashboardUID(orgID, uid string) (*reportDashboardUIDReservation, error) {
+	if strings.TrimSpace(orgID) == "" || strings.TrimSpace(uid) == "" {
+		return nil, fmt.Errorf("dashboard UID reservation is incomplete")
+	}
+	root, err := dashboardEffectStoreRoot()
+	if err != nil {
+		return nil, err
+	}
+	if err := prepareReportDashboardProvenanceRoot(root); err != nil {
+		return nil, err
+	}
+	path := reportDashboardUIDReservationPath(root, orgID, uid)
+	if err := os.Mkdir(path, 0700); err != nil {
+		if !errors.Is(err, os.ErrExist) {
+			return nil, err
+		}
+	}
+	// Sync even an existing entry: its creator may have failed before fsync.
+	if err := syncReceiptDirectory(filepath.Dir(path)); err != nil {
+		return nil, err
+	}
+	lock, err := os.OpenFile(filepath.Join(path, "lock"), os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	if err := syscall.Flock(int(lock.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		lock.Close()
+		if errors.Is(err, syscall.EWOULDBLOCK) || errors.Is(err, syscall.EAGAIN) {
+			return nil, fmt.Errorf("dashboard UID %q is reserved by an active operation", uid)
+		}
+		return nil, err
+	}
+	_, pendingErr := os.Stat(filepath.Join(path, "pending.json"))
+	if pendingErr != nil && !errors.Is(pendingErr, os.ErrNotExist) {
+		lock.Close()
+		return nil, pendingErr
+	}
+	return &reportDashboardUIDReservation{path: path, lock: lock, fresh: errors.Is(pendingErr, os.ErrNotExist)}, nil
+}
+
+func (reservation *reportDashboardUIDReservation) writePending(record reportDashboardProvenance, operationID string) error {
+	if reservation == nil || reservation.lock == nil || !reservation.fresh {
+		return fmt.Errorf("dashboard UID reservation is not writable")
+	}
+	if strings.TrimSpace(record.OrgID) == "" || strings.TrimSpace(record.UID) == "" || strings.TrimSpace(record.ReportRef) == "" || strings.TrimSpace(operationID) == "" {
+		return fmt.Errorf("report dashboard reservation is incomplete")
+	}
+	record.OperationID = operationID
+	payload, err := json.Marshal(record)
+	if err != nil {
+		return err
+	}
+	if err := persistDashboardReceipt(reservation.path, "pending.json", payload); err != nil {
+		return fmt.Errorf("report dashboard reservation persistence failed: %w", err)
+	}
+	return nil
+}
+
+func (reservation *reportDashboardUIDReservation) pending() (*reportDashboardProvenance, error) {
+	if reservation == nil {
+		return nil, fmt.Errorf("dashboard UID reservation is missing")
+	}
+	payload, err := os.ReadFile(filepath.Join(reservation.path, "pending.json"))
+	if err != nil {
+		return nil, err
+	}
+	var record reportDashboardProvenance
+	if err := json.Unmarshal(payload, &record); err != nil {
+		return nil, fmt.Errorf("report dashboard pending identity is invalid: %w", err)
+	}
+	if strings.TrimSpace(record.OrgID) == "" || strings.TrimSpace(record.UID) == "" || strings.TrimSpace(record.ReportRef) == "" || strings.TrimSpace(record.OperationID) == "" {
+		return nil, fmt.Errorf("report dashboard pending identity is incomplete")
+	}
+	return &record, nil
+}
+
+func (reservation *reportDashboardUIDReservation) release() error {
+	if reservation == nil || reservation.lock == nil {
+		return nil
+	}
+	// Never unlink the lock inode: another process may already have it open.
+	// Clear pending state durably while still holding the same OS lock.
+	if err := os.Remove(filepath.Join(reservation.path, "pending.json")); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if err := syncReceiptDirectory(reservation.path); err != nil {
+		return err
+	}
+	err := reservation.lock.Close()
+	reservation.lock = nil
+	return err
+}
+
+func (reservation *reportDashboardUIDReservation) closeWithoutRelease() {
+	if reservation != nil && reservation.lock != nil {
+		_ = reservation.lock.Close()
+		reservation.lock = nil
+	}
+}
+
+func reportDashboardProvenancePath(root, orgID, uid string) string {
+	key := sha256.Sum256([]byte(orgID + "\x00" + uid))
+	return filepath.Join(root, "report-dashboard-provenance", hex.EncodeToString(key[:]))
+}
+
+func loadDashboardEffectReceipt(operationID string) (*mcp.CallToolResult, error) {
+	root, err := dashboardEffectStoreRoot()
+	if err != nil {
+		return nil, err
+	}
+	operation := filepath.Join(root, operationID)
+	payload, err := os.ReadFile(filepath.Join(operation, "completion.json"))
+	if err != nil {
+		return nil, fmt.Errorf("dashboard effect receipt is incomplete; do not redispatch: %w", err)
+	}
+	var completion dashboardCompletion
+	if err := json.Unmarshal(payload, &completion); err != nil {
+		return nil, fmt.Errorf("dashboard completion receipt invalid: %w", err)
+	}
+	if completion.OperationID != operationID || completion.Result == nil || completion.Result.IsError {
+		return nil, fmt.Errorf("dashboard completion receipt identity/outcome is invalid")
+	}
+	return completion.Result, nil
+}
+
+// recoverReportDashboardUID consumes only a durable pending identity and a
+// completed effect receipt. The reservation's OS lock excludes its live owner.
+func recoverReportDashboardUID(reservation *reportDashboardUIDReservation, req LoopRequest, reportRef, uid, operationID string) (*mcp.CallToolResult, error) {
+	pending, err := reservation.pending()
+	if err != nil {
+		return nil, fmt.Errorf("report dashboard recovery pending identity unavailable: %w", err)
+	}
+	if pending.OrgID != req.OrgID || pending.UID != uid || pending.ReportRef != reportRef || pending.ActorID != req.UserID || pending.SessionID != req.SessionID || pending.OperationID != operationID {
+		return nil, fmt.Errorf("report dashboard recovery identity does not match actor, session, UID and report ref")
+	}
+	if len(pending.OperationID) != sha256.Size*2 {
+		return nil, fmt.Errorf("report dashboard recovery operation identity is invalid")
+	}
+	if _, err := hex.DecodeString(pending.OperationID); err != nil {
+		return nil, fmt.Errorf("report dashboard recovery operation identity is invalid: %w", err)
+	}
+	result, err := loadDashboardEffectReceipt(pending.OperationID)
+	if err != nil {
+		return nil, fmt.Errorf("report dashboard recovery receipt unavailable; do not redispatch: %w", err)
+	}
+	if actualUID := dashboardUIDFromWriterResult(result); actualUID != uid {
+		return nil, fmt.Errorf("report dashboard recovery receipt UID mismatch (expected %q, got %q); do not redispatch", uid, actualUID)
+	}
+	if err := persistReportDashboardProvenance(*pending); err != nil {
+		return nil, fmt.Errorf("report dashboard recovery provenance persistence failed; do not redispatch: %w", err)
+	}
+	// The caller holds the lock until it has finished processing this receipt.
+	return result, nil
+}
+
+func loadReportDashboardProvenance(orgID, uid string) (*reportDashboardProvenance, error) {
+	root, err := dashboardEffectStoreRoot()
+	if err != nil {
+		return nil, err
+	}
+	payload, err := os.ReadFile(filepath.Join(reportDashboardProvenancePath(root, orgID, uid), "provenance.json"))
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var record reportDashboardProvenance
+	if err := json.Unmarshal(payload, &record); err != nil {
+		return nil, fmt.Errorf("report dashboard provenance is invalid: %w", err)
+	}
+	if record.OrgID != orgID || record.UID != uid || strings.TrimSpace(record.ReportRef) == "" {
+		return nil, fmt.Errorf("report dashboard provenance identity is invalid")
+	}
+	return &record, nil
+}
+
+// persistReportDashboardProvenance atomically creates the UID record after a
+// confirmed writer success. Existing ownership is never replaced silently.
+func persistReportDashboardProvenance(record reportDashboardProvenance) error {
+	return persistReportDashboardProvenanceWithSync(record, syncReceiptDirectory)
+}
+
+func persistReportDashboardProvenanceWithSync(record reportDashboardProvenance, syncParent func(string) error) error {
+	if strings.TrimSpace(record.OrgID) == "" || strings.TrimSpace(record.UID) == "" || strings.TrimSpace(record.ReportRef) == "" {
+		return fmt.Errorf("report dashboard provenance is incomplete")
+	}
+	root, err := dashboardEffectStoreRoot()
+	if err != nil {
+		return err
+	}
+	if err := prepareReportDashboardProvenanceRoot(root); err != nil {
+		return err
+	}
+	operation := reportDashboardProvenancePath(root, record.OrgID, record.UID)
+	if err := os.Mkdir(operation, 0700); err != nil {
+		if !errors.Is(err, os.ErrExist) {
+			return err
+		}
+		if _, readErr := loadReportDashboardProvenance(record.OrgID, record.UID); readErr != nil {
+			return readErr
+		}
+	}
+	// Also covers retry after creation succeeded but its first fsync failed.
+	if err := syncParent(filepath.Dir(operation)); err != nil {
+		return err
+	}
+	payload, err := json.Marshal(record)
+	if err != nil {
+		return err
+	}
+	if err := persistDashboardReceipt(operation, "provenance.json", payload); err != nil {
+		return fmt.Errorf("report dashboard provenance persistence failed: %w", err)
+	}
+	return nil
+}
