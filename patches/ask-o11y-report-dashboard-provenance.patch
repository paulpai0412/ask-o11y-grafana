+func TestReportUIDLockInodeSurvivesRelease(t *testing.T) {
+	t.Setenv("ASKO11Y_EFFECT_STORE", t.TempDir())
+	first, err := reserveDashboardUID("org", "uid")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A contender may already have opened the inode when the owner releases.
+	waiter, err := os.OpenFile(filepath.Join(first.path, "lock"), os.O_RDWR, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer waiter.Close()
+	if err := first.release(); err != nil {
+		t.Fatal(err)
+	}
+	second, err := reserveDashboardUID("org", "uid")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer second.closeWithoutRelease()
+	if err := syscall.Flock(int(waiter.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err == nil {
+		_ = syscall.Flock(int(waiter.Fd()), syscall.LOCK_UN)
+		t.Fatal("old inode and new owner both hold the UID lock")
+	}
+}
+
+func TestReportUIDLockCrossProcessCrash(t *testing.T) {
+	if os.Getenv("ASKO11Y_LOCK_TEST_CHILD") == "1" {
+		reservation, err := reserveDashboardUID("org", "uid")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := reservation.writePending(reportDashboardProvenance{OrgID: "org", UID: "uid", ReportRef: "artifact://ref"}, strings.Repeat("a", 64)); err != nil {
+			t.Fatal(err)
+		}
+		fmt.Println("locked")
+		time.Sleep(time.Minute)
+		return
+	}
+	t.Setenv("ASKO11Y_EFFECT_STORE", t.TempDir())
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestReportUIDLockCrossProcessCrash$")
+	cmd.Env = append(os.Environ(), "ASKO11Y_LOCK_TEST_CHILD=1")
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = cmd.Process.Kill(); _ = cmd.Wait() }()
+	lines := bufio.NewScanner(stdout)
+	if !lines.Scan() || lines.Text() != "locked" {
+		t.Fatal("child did not acquire lock")
+	}
+	if other, err := reserveDashboardUID("org", "uid"); err == nil {
+		other.closeWithoutRelease()
+		t.Fatal("second process bypassed active owner")
+	}
+	if err := cmd.Process.Kill(); err != nil {
+		t.Fatal(err)
+	}
+	_ = cmd.Wait()
+	recovery, err := reserveDashboardUID("org", "uid")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer recovery.closeWithoutRelease()
+	if recovery.fresh {
+		t.Fatal("crashed owner's pending identity disappeared")
+	}
+	if _, err := recovery.pending(); err != nil {
+		t.Fatal(err)
+	}
+}
