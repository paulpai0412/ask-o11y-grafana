+func TestDashboardWriterReportBindingRecordsUIDAndRejectsEvidenceLossBeforeDispatch(t *testing.T) {
+	t.Setenv("ASKO11Y_EFFECT_STORE", t.TempDir())
+	var writerCalls atomic.Int32
+	proxy := newDashboardBoundaryProxy(t, map[string]interface{}{
+		"uid": "report-uid", "title": "Report", "panels": []interface{}{map[string]interface{}{"type": "asko11y-plotly-panel"}},
+	}, "report-uid", &writerCalls)
+	loop := NewAgentLoop(nil, proxy, log.DefaultLogger)
+	req := dashboardBoundaryRequest("session-a")
+	content, isError, kind := runDashboardBoundaryCall(t, loop, req, `{"dashboard":{"$dashboard_ref":"artifact://report-1"}}`)
+	if isError || kind != "" || !strings.Contains(content, "report-uid") {
+		t.Fatalf("canonical report write = %q, error=%t kind=%q", content, isError, kind)
+	}
+	if writerCalls.Load() != 1 {
+		t.Fatalf("writer calls = %d, want 1", writerCalls.Load())
+	}
+	if record, err := loadReportDashboardProvenance("org-1", "report-uid"); err != nil || record == nil || record.ReportRef != "artifact://report-1" {
+		t.Fatalf("provenance = %#v, err=%v", record, err)
+	}
+	content, isError, kind = runDashboardBoundaryCall(t, loop, req, `{"dashboard":{"$dashboard_ref":"artifact://report-2"}}`)
+	if isError || kind != "" || !strings.Contains(content, "report-uid") || writerCalls.Load() != 2 {
+		t.Fatalf("fresh report revision = %q, error:%t kind:%q calls:%d", content, isError, kind, writerCalls.Load())
+	}
+	if record, err := loadReportDashboardProvenance("org-1", "report-uid"); err != nil || record == nil || record.ReportRef != "artifact://report-2" {
+		t.Fatalf("revised provenance = %#v, err=%v", record, err)
+	}
+
+	// Replaying an older completed effect must not roll provenance back.
+	_, replayError, _ := runDashboardBoundaryCall(t, loop, req, `{"dashboard":{"$dashboard_ref":"artifact://report-1"}}`)
+	if !replayError || writerCalls.Load() != 2 {
+		t.Fatal("superseded report replay was accepted")
+	}
+	if record, err := loadReportDashboardProvenance("org-1", "report-uid"); err != nil || record == nil || record.ReportRef != "artifact://report-2" {
+		t.Fatalf("replay rolled provenance back: %#v, %v", record, err)
+	}
+	if content, failed, _ := runDashboardBoundaryCall(t, loop, req, `{"dashboard":{"$dashboard_ref":"artifact://report-2"}}`); failed || writerCalls.Load() != 2 {
+		t.Fatalf("current receipt replay failed after rejecting stale receipt: %s", content)
+	}
+
+	for _, args := range []string{
+		`{"dashboard":{"uid":"report-uid","title":"Renamed","panels":[]}}`,
+		`{"uid":"report-uid","operations":[{"op":"replace","path":"$.panels/0","value":{"type":"text","options":{"content":"replacement"}}}]}`,
+		`{"dashboard":{"uid":"report-uid","panels":[{"type":"row","panels":[{"type":"text","options":{"content":"replacement"}}]}]}}`,
+	} {
+		_, isError, _ := runDashboardBoundaryCall(t, loop, req, args)
+		if !isError {
+			t.Fatalf("report evidence-loss payload unexpectedly accepted: %s", args)
+		}
+	}
+	if writerCalls.Load() != 2 {
+		t.Fatalf("evidence-loss payloads reached writer: %d calls", writerCalls.Load())
+	}
+}
