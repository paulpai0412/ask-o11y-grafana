+// normalizeDashboardWriteIdentity keeps the writer's identity equal to the UID
+// protected by the host. Numeric IDs and identity-changing patches must not
+// redirect a write to a dashboard whose UID was never locked.
+func normalizeDashboardWriteIdentity(args map[string]interface{}) error {
+	if dashboard, ok := args["dashboard"].(map[string]interface{}); ok {
+		if args["operations"] != nil {
+			return fmt.Errorf("use either a complete dashboard or patch operations, not both")
+		}
+		uid := dashboardUID(dashboard)
+		if raw := dashboard["uid"]; raw != nil {
+			if _, ok := raw.(string); !ok {
+				return fmt.Errorf("dashboard UID must be a string")
+			}
+		}
+		if raw := args["uid"]; raw != nil {
+			topUID, ok := raw.(string)
+			if !ok || (strings.TrimSpace(topUID) != "" && strings.TrimSpace(topUID) != uid) {
+				return fmt.Errorf("conflicting dashboard UIDs; use one target UID")
+			}
+		}
+		if id := dashboard["id"]; id != nil && id != float64(0) && uid == "" {
+			return fmt.Errorf("existing dashboard writes require a UID, not a numeric ID")
+		}
+		copy := make(map[string]interface{}, len(dashboard))
+		for key, value := range dashboard {
+			if key != "id" {
+				copy[key] = value
+			}
+		}
+		if uid != "" {
+			copy["uid"] = uid
+		}
+		args["dashboard"] = copy
+		return nil
+	}
+	uid, _ := args["uid"].(string)
+	if strings.TrimSpace(uid) == "" {
+		return fmt.Errorf("dashboard patch writes require an explicit UID")
+	}
+	args["uid"] = strings.TrimSpace(uid)
+	operations, _ := args["operations"].([]interface{})
+	for _, raw := range operations {
+		operation, _ := raw.(map[string]interface{})
+		path, _ := operation["path"].(string)
+		// Only descending paths: no root wildcard, parent traversal or executable
+		// filters that could redirect a patch into a dashboard identity field.
+		field := dashboardPatchField.FindStringSubmatch(strings.TrimSpace(path))
+		if field == nil {
+			return fmt.Errorf("dashboard patches require a descending path to a named non-identity field; use complete dashboard JSON for complex edits")
+		}
+		name := field[1] + field[2] + field[3]
+		if name == "id" || name == "uid" {
+			return fmt.Errorf("dashboard patches cannot change identity; use the target UID")
+		}
+	}
+	return nil
+}
+
+var dashboardPatchField = regexp.MustCompile(`^\$(?:\.([A-Za-z_][A-Za-z0-9_]*)|\["([^"\\]+)"\]|\['([^'\\]+)'\])(?:\.[A-Za-z_][A-Za-z0-9_]*|\[(?:[0-9]+|\*|"[^"\\]+"|'[^'\\]+')\]|/[A-Za-z0-9_~-]+)*$`)
 
