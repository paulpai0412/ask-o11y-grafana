+func newDashboardBoundaryProxy(t *testing.T, resolved map[string]interface{}, writerUID string, writerCalls *atomic.Int32) *mcp.Proxy {
+	return newDashboardBoundaryProxyWithHook(t, resolved, writerUID, writerCalls, nil)
+}
+
+func newDashboardBoundaryProxyWithHook(t *testing.T, resolved map[string]interface{}, writerUID string, writerCalls *atomic.Int32, writerHook func()) *mcp.Proxy {
+	t.Helper()
+	bridge := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/mcp/list-tools" {
+			_ = json.NewEncoder(w).Encode(map[string]interface{}{"tools": []mcp.Tool{{Name: "resolve_dashboard_refs", InputSchema: map[string]interface{}{"type": "object"}}}})
+			return
+		}
+		if r.URL.Path == "/mcp/call-tool" {
+			_ = json.NewEncoder(w).Encode(mcp.CallToolResult{Content: []mcp.ContentBlock{{Type: "text", Text: func() string {
+				body, _ := json.Marshal(map[string]interface{}{"ok": true, "dashboard": resolved})
+				return string(body)
+			}()}}})
+			return
+		}
+		http.NotFound(w, r)
+	}))
+	writer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/mcp/list-tools" {
+			_ = json.NewEncoder(w).Encode(map[string]interface{}{"tools": []mcp.Tool{{Name: "update_dashboard", InputSchema: map[string]interface{}{"type": "object"}}}})
+			return
+		}
+		if r.URL.Path == "/mcp/call-tool" {
+			writerCalls.Add(1)
+			if writerHook != nil {
+				writerHook()
+			}
+			body, _ := json.Marshal(map[string]string{"uid": writerUID})
+			_ = json.NewEncoder(w).Encode(mcp.CallToolResult{Content: []mcp.ContentBlock{{Type: "text", Text: string(body)}}})
+			return
+		}
+		http.NotFound(w, r)
+	}))
+	t.Cleanup(bridge.Close)
+	t.Cleanup(writer.Close)
+	proxy := mcp.NewProxy(context.Background(), log.DefaultLogger)
+	t.Cleanup(proxy.Close)
+	for _, config := range []mcp.ServerConfig{
+		{ID: "artifact-bridge", URL: bridge.URL, Type: "standard", Enabled: true},
+		{ID: "mcp-grafana", URL: writer.URL, Type: "standard", Enabled: true},
+	} {
+		if err := proxy.EnsureServer(config); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := proxy.ListTools(); err != nil {
+		t.Fatal(err)
+	}
+	return proxy
+}
