+func TestReportProvenanceParentSyncBeforeCommitAndOnRetry(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("ASKO11Y_EFFECT_STORE", root)
+	record := reportDashboardProvenance{OrgID: "org", UID: "uid", ReportRef: "artifact://ref"}
+	operation := reportDashboardProvenancePath(root, record.OrgID, record.UID)
+	injected := errors.New("parent fsync fault")
+	for attempt := 0; attempt < 2; attempt++ {
+		calls := 0
+		err := persistReportDashboardProvenanceWithSync(record, func(parent string) error {
+			calls++
+			if parent != filepath.Dir(operation) {
+				t.Fatalf("wrong parent: %s", parent)
+			}
+			if _, err := os.Stat(operation); err != nil {
+				t.Fatal("directory not created before fsync")
+			}
+			if _, err := os.Stat(filepath.Join(operation, "provenance.json")); !errors.Is(err, os.ErrNotExist) {
+				t.Fatal("provenance committed before parent fsync")
+			}
+			return injected
+		})
+		if !errors.Is(err, injected) || calls != 1 {
+			t.Fatalf("parent sync bypassed on attempt %d: %v", attempt, err)
+		}
+	}
+	if err := persistReportDashboardProvenance(record); err != nil {
+		t.Fatal(err)
+	}
+}
 
