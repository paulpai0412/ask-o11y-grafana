diff --git a/pkg/agent/native_presentation_test.go b/pkg/agent/native_presentation_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/agent/native_presentation_test.go
@@ -0,0 +1,28 @@
+package agent
+
+import "testing"
+
+func TestNativePresentationFailureRemainsPartial(t *testing.T) {
+	s := newDeliveryState("Explain the observations")
+	s.observe("sandbox-analysis_execute_python_analysis", `{"ok":true,"refs":{"report_manifest_ref":"artifact://r/report-manifest"},"evidence":{"presentation_errors":[{"artifact_id":"plot","code":"invalid_native_figure"}]}}`, false)
+	if s.deliveryStatus() != "partial" || len(s.gaps) == 0 {
+		t.Fatalf("partial presentation hidden: %+v", s)
+	}
+	s.observe("mcp-grafana_update_dashboard", `{"ok":true,"uid":"preview"}`, false)
+	if s.deliveryStatus() != "partial" || s.writerStatus != "succeeded" {
+		t.Fatalf("writer promoted presentation: %+v", s)
+	}
+	s.observeCall("grafana-query_execute_planned_query", `{"plan_ref":"artifact://new/query-plan"}`, `{"ok":true,"refs":{"frame_ref":"artifact://new/grafana-frame"}}`, false)
+	if s.deliveryStatus() != "not_assessed" {
+		t.Fatalf("fresh query retained stale partial: %+v", s)
+	}
+}
+
+func TestPartialFigureCannotClearUnresolvedToolError(t *testing.T) {
+	s := newDeliveryState("Explain the observations")
+	s.lastToolError, s.lastErrorFrame = "prior error", "artifact://r/grafana-frame"
+	s.observeCall("sandbox-analysis_execute_python_analysis", `{"frame_ref":"artifact://r/grafana-frame"}`, `{"ok":true,"refs":{"report_manifest_ref":"artifact://r/report-manifest"},"evidence":{"presentation_errors":[{"code":"invalid_native_figure"}]}}`, false)
+	if s.lastToolError != "prior error" || s.deliveryStatus() != "partial" {
+		t.Fatalf("partial cleared error: %+v", s)
+	}
+}
