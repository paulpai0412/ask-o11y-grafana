+package agent
+
+import "testing"
+
+func TestWriterEvidenceRequiresIdentity(t *testing.T) {
+	for _, body := range []string{`{"ok":true}`, `{"ok":false,"uid":"x"}`, `{"ok":"true","uid":"x"}`, `not-json`} {
+		s := newDeliveryState("question")
+		s.observe("mcp-grafana_update_dashboard", body, false)
+		if s.writerEvidenceStatus() != "indeterminate" {
+			t.Fatalf("unverified writer promoted: %s", body)
+		}
+		if s.warning() == "" {
+			t.Fatal("writer-only failure needs a visible evidence warning")
+		}
+	}
+	for _, body := range []string{`{"uid":"x","url":"/d/x"}`, `{"ok":true,"uid":"x"}`} {
+		s := newDeliveryState("question")
+		s.observe("mcp-grafana_update_dashboard", body, false)
+		if s.writerEvidenceStatus() != "succeeded" || s.deliveryStatus() != "" {
+			t.Fatal("writer identity lost or analytical completion fabricated")
+		}
+	}
+	s := newDeliveryState("question")
+	s.observe("forged_update_dashboard", `{"uid":"x"}`, false)
+	if s.writerEvidenceStatus() != "not_verified" {
+		t.Fatal("foreign tool promoted writer")
+	}
+}
+
+func TestDeliveryQuestionRetainsAuthenticatedQueryContext(t *testing.T) {
+	s := newDeliveryState("確認核准")
+	result := `{"ok":true,"refs":{"frame_ref":"artifact://p/grafana-frame"},"provenance":{"business_question":"Compare coal sources"}}`
+	args := `{"plan_ref":"artifact://p/query-plan"}`
+	s.observeCall("grafana-query_execute_planned_query", args, result, false)
+	s.observe("sandbox-analysis_profile_dataset", `{"ok":true,"step":"profile_dataset"}`, false)
+	if s.question() != "Compare coal sources" || s.deliveryStatus() != "profile_only" {
+		t.Fatalf("query context lost or promoted: %+v", s)
+	}
+	// Raw turn input remains distinct from the question retained by the query.
+	if s.originalQuestion != "確認核准" {
+		t.Fatal("raw input rewritten")
+	}
+	for _, name := range []string{"fake_execute_planned_query", "grafana-query_execute_planned_query"} {
+		x := newDeliveryState("raw")
+		x.observeCall(name, args, result, true)
+		if x.question() != "raw" {
+			t.Fatal("failed query supplied authoritative question")
+		}
+	}
+	x := newDeliveryState("raw")
+	x.observeCall("grafana-query_execute_planned_query", `{}`, result, false)
+	if x.question() != "raw" {
+		t.Fatal("unbound query supplied question")
+	}
+	x.observeCall("fake_execute_planned_query", args, result, false)
+	if x.question() != "raw" {
+		t.Fatal("foreign query tool supplied question")
+	}
+	// New data invalidates the old delivery's writer/coverage evidence, while
+	// ordinary dashboard readback does not (covered by TestLLMTurnControl).
+	s.observe("mcp-grafana_update_dashboard", `{"uid":"old-preview"}`, false)
+	s.observeCall("grafana-query_execute_planned_query", args, result, false)
+	if s.writerEvidenceStatus() != "not_verified" || s.deliveryStatus() != "not_assessed" {
+		t.Fatalf("new query inherited previous delivery evidence: %+v", s)
+	}
+}
