--- /dev/null
+++ b/pkg/agent/upload_capability_test.go
@@ -0,0 +1,20 @@
+package agent
+
+import "testing"
+
+func TestConversationHasExactUploadDataset(t *testing.T) {
+	valid := []Message{{Role: "user", Content: "Use uploaded dataset `upload_c67e717d4686ec55d897dee03dddd917` (adult.csv)."}}
+	if !conversationHasExactUploadDataset(valid) {
+		t.Fatal("exact UI upload evidence was not recognized")
+	}
+	invalid := [][]Message{
+		{{Role: "assistant", Content: "upload_c67e717d4686ec55d897dee03dddd917"}},
+		{{Role: "user", Content: "upload_short"}},
+		{{Role: "user", Content: "prefix_upload_c67e717d4686ec55d897dee03dddd917_suffix"}},
+	}
+	for _, messages := range invalid {
+		if conversationHasExactUploadDataset(messages) {
+			t.Fatalf("invalid upload evidence was accepted: %q", messages[0].Content)
+		}
+	}
+}
