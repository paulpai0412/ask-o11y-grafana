+package agent
+
+import (
+	"strings"
+	"testing"
+)
+
+// Exercise embedded skill discovery and selection, not a second Markdown parser.
+func TestAnalystSkillsContract(t *testing.T) {
+	required := map[string][]string{
+		"data-understanding": {
+			"advisory knowledge", "Do not ask the user to design the procedure",
+			"A profile is evidence, not completion", "wait for confirmation",
+			"outside that contract", "full-data", "observed candidate",
+			"only for unresolved business meaning", "Only Grafana Query",
+			"Keep facts, uncertainty and limitations unchanged across audiences",
+			"indeterminate compute/write outcomes", "Dummy baseline gate",
+			"mode=spec", "visual_observation=null", "thesis_evidence",
+			"refs.dashboard_ref", "independent per-view narratives",
+		},
+		"ml-method-selection": {
+			"advisory knowledge", "Do not ask the user to choose algorithms",
+			"conditional examples, not execution recipes", "wait for confirmation",
+			"outside the confirmed contract", "training CV only",
+			"one global search budget", "Lock the winner before final holdout",
+			"no sampling, truncation or derived datasets", "Dummy baseline gate",
+			"support_group_fields must be context_fields", "bounds: {}",
+			"calibrated_probabilities", "CatBoost", "受控 challenger",
+			"pre-specified confirmatory result", "mode=spec", "visual_observation=null",
+			"Keep facts, uncertainty and limitations unchanged across audiences",
+			"refs.dashboard_ref", "thesis_evidence", "independent per-view narratives",
+		},
+	}
+	found := 0
+	for _, skill := range availableAgentSkills() {
+		needles, ok := required[skill.Name]
+		if !ok {
+			continue
+		}
+		found++
+		t.Run(skill.Name, func(t *testing.T) {
+			if skill.Description == "" || len(skill.Content) > maxSkillContextBytes {
+				t.Fatal("skill must be discoverable and within the existing context bound")
+			}
+			messages := selectedSkillMessages([]string{skill.Name})
+			if len(messages) != 1 || !strings.Contains(messages[0].Content, skill.Content) {
+				t.Fatal("selected advisory must reach the model intact")
+			}
+			for _, needle := range needles {
+				if !strings.Contains(skill.Content, needle) {
+					t.Errorf("missing responsibility or guardrail: %q", needle)
+				}
+			}
+			for _, forbidden := range []string{
+				"Only after the user explicitly asks", "一般無時間欄的二元分類使用 stratified holdout",
+				"一律 `TimeSeriesSplit`", "處理順序：", "小樣本（n<1000）",
+				"預設往高 recall 偏移", "PSI<0.1", "Cpk≥1.33",
+				"對 SHAP 前 K 名特徵（K≤10）回頭做單變數檢定",
+			} {
+				if strings.Contains(skill.Content, forbidden) {
+					t.Errorf("legacy method/intent recipe survived: %q", forbidden)
+				}
+			}
+		})
+	}
+	if found != len(required) {
+		t.Fatalf("found %d analyst skills, want %d", found, len(required))
+	}
+}
