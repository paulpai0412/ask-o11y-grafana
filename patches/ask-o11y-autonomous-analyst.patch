+package plugin
+
+import (
+	"strings"
+	"testing"
+)
+
+// These are prompt assembly regressions, not evidence of model behavior.
+func TestAnalystPromptContract(t *testing.T) {
+	r, err := NewPromptRegistry(PluginSettings{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, role := range []string{"Viewer", "Editor", "Admin"} {
+		t.Run(role, func(t *testing.T) {
+			out, err := r.BuildSystemPrompt(BuildToolContext("Org1", role))
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, required := range []string{
+				"The user supplies the decision question and authorization, not an algorithm",
+				"Choose defensible methods, validation design",
+				"not which algorithm to use",
+				"not a mandatory terminal answer or method selector",
+				"plain-language decision summary",
+				"Keep facts, uncertainty, and limitations unchanged across audiences",
+				"not a Grafana permission role and never grants access",
+				"exact Analysis Preview",
+				"wait for confirmation",
+				"outside that confirmed contract",
+				"Do not reinterpret an earlier confirmation as blanket permission",
+				"Existing host approval, data isolation, full-data, budget, and publication gates",
+				"lock the winner before holdout evaluation",
+				"reconcile its existing operation receipt",
+				"post-hoc selection",
+				"Capability honesty",
+			} {
+				if !strings.Contains(out, required) {
+					t.Errorf("missing analyst/guardrail directive: %q", required)
+				}
+			}
+			for _, forbidden := range []string{
+				"If missing required parameters, ask the user rather than guessing",
+				"If the user did not explicitly ask for prediction/modeling",
+				"Read/query/list/search tools are always fine",
+			} {
+				if strings.Contains(out, forbidden) {
+					t.Errorf("conflicting legacy directive: %q", forbidden)
+				}
+			}
+		})
+	}
+}
+
+func TestAnalystPromptPreservesCustomOverride(t *testing.T) {
+	const custom = "Organization custom instruction."
+	r, err := NewPromptRegistry(PluginSettings{DefaultSystemPrompt: custom})
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err := r.BuildSystemPrompt(BuildToolContext("Org1", "Viewer"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(out, custom) || strings.Contains(out, "## Analyst responsibility and audience") {
+		t.Fatal("custom prompts must not be silently replaced; migration requires operator review")
+	}
+}
