+func TestApprovalPolicyAutoApprove(t *testing.T) {
+	for policy, want := range map[string]bool{
+		"approved":             true,
+		"approval-gated-writes": false,
+		"off":                   false,
+	} {
+		if got := approvalPolicyAutoApprove(policy); got != want {
+			t.Errorf("approvalPolicyAutoApprove(%q) = %t, want %t", policy, got, want)
+		}
+	}
