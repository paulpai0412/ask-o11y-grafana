+func TestApprovedPolicyExecutesRiskyToolWithoutApprovalWait(t *testing.T) {
+	ctx := context.Background()
+	mcpServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/mcp/list-tools":
+			json.NewEncoder(w).Encode(map[string]interface{}{"tools": []map[string]interface{}{{"name": "profile_dataset", "inputSchema": map[string]string{"type": "object"}}}})
+		case "/mcp/call-tool":
+			json.NewEncoder(w).Encode(map[string]interface{}{"content": []map[string]string{{"type": "text", "text": `{"ok":true}`}}})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer mcpServer.Close()
+
+	proxy := mcp.NewProxy(ctx, log.DefaultLogger)
+	defer proxy.Close()
+	if err := proxy.EnsureServer(mcp.ServerConfig{ID: "sandbox-analysis", URL: mcpServer.URL, Type: "standard", Enabled: true}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := proxy.ListTools(); err != nil {
+		t.Fatal(err)
+	}
+	loop := NewAgentLoop(nil, proxy, log.DefaultLogger)
+	events := make(chan SSEEvent, 4)
+	registerCalled := false
+	content, isError, errorKind := loop.executeToolWithApproval(ctx, events, ToolCall{ID: "call-1", Function: FunctionCall{Name: "sandbox-analysis_profile_dataset", Arguments: `{}`}}, LoopRequest{
+		ApprovalPolicy: "approved",
+		UserRole:       "Admin",
+		OrgID:          "1",
+		MCPServers:     []mcp.ServerConfig{{ID: "sandbox-analysis", Enabled: true}},
+		RegisterApproval: func(context.Context, ApprovalRequestEvent) (ApprovalWaitFunc, error) {
+			registerCalled = true
+			return nil, fmt.Errorf("approval wait should not be registered")
+		},
+	})
+	if isError || errorKind != "" || !strings.Contains(content, `"ok":true`) {
+		t.Fatalf("approved policy tool execution = %q, error=%t kind=%q", content, isError, errorKind)
+	}
+	if registerCalled || len(events) != 2 {
+		t.Fatalf("approval broker/events = called:%t events:%d, want no broker and request/resolution trace", registerCalled, len(events))
+	}
+	first, second := <-events, <-events
+	if first.Type != "approval_request" || second.Type != "approval_resolved" {
+		t.Fatalf("unexpected approval trace: %#v, %#v", first, second)
+	}
+}
