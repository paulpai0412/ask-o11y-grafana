diff --git a/pkg/agent/plotly_recovery_test.go b/pkg/agent/plotly_recovery_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/agent/plotly_recovery_test.go
@@ -0,0 +1,124 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"consensys-asko11y-app/pkg/mcp"
+	"github.com/grafana/grafana-plugin-sdk-go/backend/httpclient"
+	"github.com/grafana/grafana-plugin-sdk-go/backend/log"
+)
+
+// The fixture is exported by the real isolated Python producer, not hand-written
+// capabilities. Exercise actual MCP -> tool schema -> LLM request -> final SSE.
+func TestPlotlyCapabilityAndErrorReachLLM(t *testing.T) {
+	path := os.Getenv("PLOTLY_TOOL_FIXTURE_OUT")
+	if path == "" {
+		t.Skip("run scripts/check-plotly-recovery.py with PLOTLY_TOOL_FIXTURE_OUT first")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixture struct {
+		Tools     []mcp.Tool      `json:"tools"`
+		Rejection json.RawMessage `json:"rejection"`
+	}
+	if err := json.Unmarshal(data, &fixture); err != nil {
+		t.Fatal(err)
+	}
+	var selected mcp.Tool
+	for _, tool := range fixture.Tools {
+		if tool.Name == "execute_python_analysis" {
+			selected = tool
+		}
+	}
+	if !strings.Contains(selected.Description, "nested_keys") {
+		t.Fatal("producer capability missing")
+	}
+	t.Setenv("ASKO11Y_EFFECT_STORE", t.TempDir())
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/mcp/list-tools" {
+			_ = json.NewEncoder(w).Encode(map[string]interface{}{"tools": []mcp.Tool{selected}})
+			return
+		}
+		_ = json.NewEncoder(w).Encode(mcp.CallToolResult{IsError: true, Content: []mcp.ContentBlock{{Type: "text", Text: string(fixture.Rejection)}}})
+	}))
+	defer server.Close()
+	requests := make(chan ChatCompletionRequest, 8)
+	calls := 0
+	llm := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body ChatCompletionRequest
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+			return
+		}
+		requests <- body
+		var message Message
+		switch calls {
+		case 0:
+			message = Message{Role: "assistant", Content: `{"tools":["sandbox-analysis_execute_python_analysis"],"skills":[]}`}
+		case 1:
+			message = Message{Role: "assistant", ToolCalls: []ToolCall{{ID: "compute", Type: "function", Function: FunctionCall{Name: "sandbox-analysis_execute_python_analysis", Arguments: `{"frame_ref":"artifact://fixture/grafana-frame","python_code":"bad"}`}}}}
+		default:
+			message = Message{Role: "assistant", Content: "Report rejected; retain the original error and correct code on the same frame after approval."}
+		}
+		calls++
+		respondAsStream(w, ChatCompletionResponse{Choices: []Choice{{Message: message, FinishReason: "stop"}}})
+	}))
+	defer llm.Close()
+	proxy := mcp.NewProxy(context.Background(), log.DefaultLogger)
+	defer proxy.Close()
+	if err := proxy.EnsureServer(mcp.ServerConfig{ID: "sandbox-analysis", URL: server.URL, Type: "standard", Enabled: true}); err != nil {
+		t.Fatal(err)
+	}
+	client, err := httpclient.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.CloseIdleConnections()
+	loop := NewAgentLoop(NewLLMClient(log.DefaultLogger, client), proxy, log.DefaultLogger)
+	ch := make(chan SSEEvent, 64)
+	req := LoopRequest{Messages: []Message{{Role: "user", Content: "Inspect the authorized frame."}}, SystemPrompt: "Custom system prompt", MaxIterations: 4, GrafanaURL: llm.URL, AuthToken: "synthetic", UserRole: "Admin", UserID: "42", SessionID: "fixture", OrgID: "1", MCPServers: []mcp.ServerConfig{{ID: "sandbox-analysis", Enabled: true}}}
+	req.RegisterApproval = func(_ context.Context, a ApprovalRequestEvent) (ApprovalWaitFunc, error) {
+		return func(context.Context) (ApprovalResolvedEvent, error) {
+			return ApprovalResolvedEvent{ApprovalID: a.ApprovalID, Decision: "approved"}, nil
+		}, nil
+	}
+	go loop.Run(context.Background(), req, ch)
+	seenFinal := false
+	for event := range ch {
+		if event.Type == "error" {
+			t.Errorf("loop error: %+v", event)
+		}
+		if event.Type == "final_report" {
+			final := event.Data.(FinalReportEvent)
+			seenFinal = strings.Contains(final.Summary, "unsupported_axis_key")
+		}
+	}
+	if !seenFinal {
+		t.Fatal("final host summary hid structural error")
+	}
+	foundDescription, foundOriginal := false, false
+	for len(requests) > 0 {
+		request := <-requests
+		for _, tool := range request.Tools {
+			if tool.Function.Name == "sandbox-analysis_execute_python_analysis" && tool.Function.Description == selected.Description {
+				foundDescription = true
+			}
+		}
+		for _, msg := range request.Messages {
+			if msg.Role == "tool" && msg.Content == string(fixture.Rejection) {
+				foundOriginal = true
+			}
+		}
+	}
+	if !foundDescription || !foundOriginal {
+		t.Fatalf("capability=%v original error=%v", foundDescription, foundOriginal)
+	}
+}
