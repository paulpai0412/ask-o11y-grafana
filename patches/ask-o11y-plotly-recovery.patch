+func (s *deliveryState) clearToolError() {
+	s.lastToolError, s.lastErrorFrame, s.lastErrorExecution = "", "", ""
+}
+
+// Only structural validator messages are safe for the host summary. Full tool
+// errors stay in the authorized tool receipt, not an arbitrary JSON echo here.
+var publicPlotlyKeyError = regexp.MustCompile(`(?:unsupported (?:layout(?:\.[A-Za-z][A-Za-z0-9_]*)?|trace|shape) key '[A-Za-z][A-Za-z0-9_]{0,40}'|forbidden key '[A-Za-z][A-Za-z0-9_]{0,40}' in (?:layout|trace)(?:\.[A-Za-z][A-Za-z0-9_]*)?)$`)
+
+func deliveryErrorSummary(payload map[string]interface{}) string {
+	evidence, _ := payload["evidence"].(map[string]interface{})
+	if evidence["effect_outcome"] == "indeterminate" {
+		return "Operation outcome is indeterminate; reconcile its receipt before retrying or correcting code."
+	}
+	message := firstString(payload, "error")
+	if strings.Contains(message, "plotly figure contract violation:") {
+		if detail := publicPlotlyKeyError.FindString(message); detail != "" && len(detail) <= 200 {
+			summary := "Report rejected: " + detail + "."
+			if evidence["computation_status"] == "succeeded" {
+				summary += " Computation succeeded; this does not establish report delivery."
+			}
+			return summary
+		}
+	}
+	switch evidence["error_code"] {
+	case "report_contract_rejected":
+		return "Computation succeeded; report rejected by the contract. Correct Python on the same authorized frame; see the original tool error."
+	case "report_persistence_failed":
+		return "Computation succeeded; report persistence failed. Retain the receipt and use its recovery instruction."
+	default:
+		return "Tool failed; its detailed error remains in the authorized tool receipt."
+	}
+}
