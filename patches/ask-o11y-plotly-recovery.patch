+func TestDeliveryWarningRetainsBoundedReportError(t *testing.T) {
+	s := newDeliveryState("question")
+	plan := `{"ok":true,"refs":{"plan_ref":"artifact://plan/query-plan"}}`
+	s.observe("data-query-planner_plan_query", plan, false)
+	s.observe("sandbox-analysis_execute_python_analysis", `{"ok":false,"error":"report manifest rejected: plotly figure contract violation: unsupported layout.xaxis key 'tickangle'","evidence":{"frame_ref":"artifact://input/grafana-frame","execution_ref":"artifact://old/sandbox-execution"},"private":"SYNTHETIC_PRIVATE"}`, true)
+	if !strings.Contains(s.warning(), "unsupported layout.xaxis key 'tickangle'") || strings.Contains(s.warning(), "SYNTHETIC_PRIVATE") {
+		t.Fatalf("error detail missing or unrelated JSON echoed: %s", s.warning())
+	}
+	s.observe("data-query-planner_plan_query", plan, false)
+	if s.lastToolError == "" {
+		t.Fatal("same-plan success erased an unresolved report error")
+	}
+	s.observe("sandbox-analysis_execute_python_analysis", `{"ok":true,"refs":{"report_manifest_ref":"artifact://other/report-manifest"},"provenance":{"input_frame_ref":"artifact://other/grafana-frame"}}`, false)
+	if s.lastToolError == "" {
+		t.Fatal("other frame erased an unresolved report error")
+	}
+	s.observe("sandbox-analysis_execute_python_analysis", `{"ok":true,"refs":{"report_manifest_ref":"artifact://new/report-manifest"},"provenance":{"input_frame_ref":"artifact://input/grafana-frame"}}`, false)
+	if s.lastToolError != "" {
+		t.Fatal("same-frame accepted report did not resolve its error")
+	}
+	for _, detail := range []string{strings.Repeat("錯", 400), "Bearer SYNTHETIC_PRIVATE", "<script>SYNTHETIC_PRIVATE</script>"} {
+		payload, err := json.Marshal(map[string]interface{}{"ok": false, "error": detail})
+		if err != nil {
+			t.Fatal(err)
+		}
+		s.observe("sandbox-analysis_execute_python_analysis", string(payload), true)
+		if !utf8.ValidString(s.warning()) || len(s.lastToolError) > 1024 || strings.Contains(s.warning(), detail) {
+			t.Fatal("unclassified raw error was displayed or split")
+		}
+	}
+	s.observe("sandbox-analysis_repair_generic_report", `{"ok":false,"error":"raw","evidence":{"effect_outcome":"indeterminate"}}`, true)
+	if !strings.Contains(s.warning(), "reconcile") {
+		t.Fatal("unknown effect lost reconciliation instruction")
+	}
+}
 
