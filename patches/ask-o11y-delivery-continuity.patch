@@ -0,0 +1,183 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"consensys-asko11y-app/pkg/mcp"
+	"github.com/grafana/grafana-plugin-sdk-go/backend/log"
+)
+
+type deliveryReplayCall struct {
+	Name      string                 `json:"name"`
+	Arguments map[string]interface{} `json:"arguments"`
+	Result    json.RawMessage        `json:"result"`
+}
+
+// Each response is exported unchanged by the public Python producers in an
+// isolated fixture run. Only LLM planning and the network transport are faked.
+func TestDeliveryPublicProducerReplay(t *testing.T) {
+	path := os.Getenv("Y5_DELIVERY_FIXTURE_OUT")
+	if path == "" {
+		t.Skip("run scripts/check-y5-minimal-repair.py with Y5_DELIVERY_FIXTURE_OUT first")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixture struct {
+		Cases []struct {
+			Name, Question, Status string
+			Calls                  []deliveryReplayCall
+		} `json:"cases"`
+		OriginalsUnchanged bool `json:"originals_unchanged"`
+		AddedCompute       int  `json:"repair_added_compute_calls"`
+	}
+	if err := json.Unmarshal(data, &fixture); err != nil {
+		t.Fatal(err)
+	}
+	if !fixture.OriginalsUnchanged || fixture.AddedCompute != 0 || len(fixture.Cases) == 0 {
+		t.Fatal("invalid producer preservation receipt")
+	}
+	for _, tc := range fixture.Cases {
+		for _, ending := range []string{"normal", "budget", "llm_error", "truncated"} {
+			t.Run(tc.Name+"/"+ending, func(t *testing.T) {
+				events := replayDeliveryCalls(t, tc.Calls, ending)
+				var report *FinalReportEvent
+				var content string
+				for _, event := range events {
+					if event.Type == "final_report" {
+						value := event.Data.(FinalReportEvent)
+						report = &value
+					}
+					if event.Type == "content" {
+						content += event.Data.(ContentEvent).Content
+					}
+				}
+				if report == nil || report.DeliveryStatus != tc.Status || report.BusinessQuestion != tc.Question {
+					t.Fatalf("real producer delivery lost at %s: %#v; want %s / %s", ending, report, tc.Status, tc.Question)
+				}
+				if len(report.Gaps) == 0 || !strings.Contains(content, tc.Question) || !strings.Contains(content, "REQUIREMENTS_NOT_RECORDED") {
+					t.Fatalf("original question/gaps absent from final content: report=%#v content=%q", report, content)
+				}
+				wantLast := "error"
+				if ending == "normal" {
+					wantLast = "done"
+				}
+				if events[len(events)-1].Type != wantLast {
+					t.Fatalf("transport terminal changed: %#v", events[len(events)-1])
+				}
+			})
+		}
+	}
+}
+
+func replayDeliveryCalls(t *testing.T, calls []deliveryReplayCall, ending string) []SSEEvent {
+	t.Helper()
+	t.Setenv("ASKO11Y_EFFECT_STORE", t.TempDir())
+	proxy := mcp.NewProxy(context.Background(), log.DefaultLogger)
+	t.Cleanup(proxy.Close)
+	groups := map[string][]mcp.Tool{}
+	var names []string
+	for _, call := range calls {
+		server, name, ok := strings.Cut(call.Name, "_")
+		if !ok {
+			t.Fatal(call.Name)
+		}
+		duplicate := false
+		for _, tool := range groups[server] {
+			if tool.Name == name {
+				duplicate = true
+			}
+		}
+		if !duplicate {
+			groups[server] = append(groups[server], mcp.Tool{Name: name, InputSchema: map[string]interface{}{"type": "object"}})
+			names = append(names, call.Name)
+		}
+	}
+	var received atomic.Int32
+	var configs []mcp.ServerConfig
+	for server, tools := range groups {
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			switch r.URL.Path {
+			case "/mcp/list-tools":
+				_ = json.NewEncoder(w).Encode(map[string]interface{}{"tools": tools})
+			case "/mcp/call-tool":
+				var rpc mcp.MCPRequest
+				if err := json.NewDecoder(r.Body).Decode(&rpc); err != nil {
+					t.Error(err)
+					return
+				}
+				var params mcp.CallToolParams
+				if err := json.Unmarshal(rpc.Params, &params); err != nil {
+					t.Error(err)
+					return
+				}
+				i := int(received.Add(1)) - 1
+				if i >= len(calls) {
+					t.Error("unexpected extra tool dispatch")
+					http.Error(w, "extra dispatch", 500)
+					return
+				}
+				call := calls[i]
+				if server+"_"+params.Name != call.Name {
+					t.Errorf("wrong actual dispatcher: %s_%s want %s", server, params.Name, call.Name)
+				}
+				var result map[string]interface{}
+				_ = json.Unmarshal(call.Result, &result)
+				_ = json.NewEncoder(w).Encode(mcp.CallToolResult{IsError: result["ok"] != true, Content: []mcp.ContentBlock{{Type: "text", Text: string(call.Result)}}})
+			default:
+				http.NotFound(w, r)
+			}
+		}))
+		t.Cleanup(srv.Close)
+		config := mcp.ServerConfig{ID: server, URL: srv.URL, Type: "standard", Enabled: true}
+		if err := proxy.EnsureServer(config); err != nil {
+			t.Fatal(err)
+		}
+		configs = append(configs, config)
+	}
+	var llmCalls atomic.Int32
+	llm := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		i := int(llmCalls.Add(1)) - 1
+		var msg Message
+		finish := "stop"
+		if i == 0 {
+			selection, _ := json.Marshal(map[string]interface{}{"tools": names, "skills": []string{}, "datasource_families": []string{}, "prepare_grafana_preview_after_execution": false, "publish_reviewed_grafana_preview": false})
+			msg = Message{Role: "assistant", Content: string(selection)}
+		} else if i <= len(calls) {
+			args, _ := json.Marshal(calls[i-1].Arguments)
+			msg = Message{Role: "assistant", ToolCalls: []ToolCall{{ID: fmt.Sprintf("call-%d", i), Type: "function", Function: FunctionCall{Name: calls[i-1].Name, Arguments: string(args)}}}}
+			finish = "tool_calls"
+		} else if ending == "llm_error" {
+			http.Error(w, "offline terminal failure", http.StatusBadRequest)
+			return
+		} else if ending == "truncated" {
+			msg = Message{Role: "assistant", ToolCalls: []ToolCall{{ID: "cut", Type: "function", Function: FunctionCall{Name: calls[0].Name, Arguments: "{"}}}}
+			finish = "length"
+		} else {
+			msg = Message{Role: "assistant", Content: "The model says it is complete."}
+		}
+		respondAsStream(w, ChatCompletionResponse{Choices: []Choice{{Message: msg, FinishReason: finish}}})
+	}))
+	t.Cleanup(llm.Close)
+	max := len(calls) + 1
+	if ending == "budget" {
+		max = len(calls)
+	}
+	loop := NewAgentLoop(NewLLMClient(log.DefaultLogger, llm.Client()), proxy, log.DefaultLogger)
+	events := make(chan SSEEvent, 128)
+	go loop.Run(context.Background(), LoopRequest{Messages: []Message{{Role: "user", Content: "Continue the existing report"}}, OriginalBusinessQuestion: "Continue the existing report", SystemPrompt: "offline replay", GrafanaURL: llm.URL, UserRole: "Admin", UserID: "7", OrgID: "1", SessionID: "replay-session", MCPServers: configs, MaxIterations: max, ApprovalPolicy: "approved"}, events)
+	got := collectEvents(events)
+	if int(received.Load()) != len(calls) {
+		t.Fatalf("producer sequence not reached: got %d/%d calls, events=%#v", received.Load(), len(calls), got)
+	}
+	return got
+}
