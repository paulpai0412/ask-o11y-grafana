diff --git a/pkg/plugin/input_continuity_test.go b/pkg/plugin/input_continuity_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/plugin/input_continuity_test.go
@@ -0,0 +1,149 @@
+package plugin
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func decodePriorState(t *testing.T, state string) []map[string]interface{} {
+	t.Helper()
+	start := strings.Index(state, "[{")
+	if start < 0 {
+		t.Fatalf("missing prior state: %q", state)
+	}
+	data := strings.TrimSuffix(state[start:], "]")
+	if len(data) > 16*1024 {
+		t.Fatalf("history budget exceeded: %d", len(data))
+	}
+	var records []map[string]interface{}
+	if err := json.Unmarshal([]byte(data), &records); err != nil {
+		t.Fatalf("malformed prior state: %v", err)
+	}
+	return records
+}
+
+func TestPriorFailureRetainsExactArgumentsAndError(t *testing.T) {
+	args := `{"python_code":"print('Country-A')","frame_ref":"artifact://input/grafana-frame"}`
+	failure := `{"ok":false,"error":"report rejected","evidence":{"execution_ref":"artifact://result/sandbox-execution"}}`
+	raw, _ := json.Marshal([]map[string]interface{}{{"name": "sandbox-analysis_execute_python_analysis", "arguments": args, "error": failure}})
+	state := compactPriorToolState(raw)
+	records := decodePriorState(t, state)
+	if len(records) != 1 || records[0]["arguments"] != args || records[0]["error"] != failure || records[0]["ok"] != false {
+		t.Fatalf("failure rewritten or omitted: %#v", records)
+	}
+	if !strings.Contains(state, "not automatic retry authority") {
+		t.Fatal("history must not grant retry permission")
+	}
+}
+
+func TestPriorStateBoundsCompleteRecords(t *testing.T) {
+	largeResult, _ := json.Marshal(map[string]interface{}{"ok": true, "refs": map[string]string{"execution_ref": "artifact://old/sandbox-execution"}, "output_summary": strings.Repeat("字", 20000)})
+	raw, _ := json.Marshal([]map[string]interface{}{
+		{"name": "profile", "response": map[string]interface{}{"content": []map[string]string{{"text": string(largeResult)}}}},
+		{"name": "python", "arguments": strings.Repeat("字", 20000), "error": "report rejected"},
+	})
+	records := decodePriorState(t, compactPriorToolState(raw))
+	if len(records) != 2 || records[0]["output_summary_omitted"] != true || records[1]["arguments_omitted"] != true || records[1]["error"] != "report rejected" {
+		t.Fatalf("omission is not explicit: %#v", records)
+	}
+	var many []map[string]interface{}
+	for i := 0; i < 100; i++ {
+		many = append(many, map[string]interface{}{"name": fmt.Sprintf("tool-%d", i), "error": strings.Repeat("x", 500)})
+	}
+	raw, _ = json.Marshal(many)
+	records = decodePriorState(t, compactPriorToolState(raw))
+	if records[0]["earlier_tool_states_omitted"] == nil || records[len(records)-1]["tool"] != "tool-99" {
+		t.Fatal("budget must retain newest complete records and disclose omissions")
+	}
+}
+
+func TestHandleAgentRunKeepsTaskModelAndFailureContext(t *testing.T) {
+	for _, approval := range []string{"授權執行 Python 視覺分析", "同意"} {
+		t.Run(approval, func(t *testing.T) {
+			llm, received := newAgentRunLLMServer(t)
+			defer llm.Close()
+			p := newAgentRunTestPlugin(t)
+			code := "print('prior analysis')"
+			args, _ := json.Marshal(map[string]string{"python_code": code, "frame_ref": "artifact://input/grafana-frame"})
+			calls, _ := json.Marshal([]map[string]interface{}{{"name": "sandbox-analysis_execute_python_analysis", "arguments": string(args), "error": "report rejected, keep execution_ref"}})
+			session, err := p.sessionStore.CreateSession(7, 2, "analysis", []SessionMessage{
+				{Role: "user", Content: "確認執行並產出dashboard preview"},
+				{Role: "assistant", Content: "The report failed.", ToolCalls: calls},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			body, _ := json.Marshal(map[string]string{"message": approval, "type": "chat", "sessionId": session.ID})
+			req := newAgentRunRequest(t, llm.URL, "/api/agent/run", string(body))
+			rec := httptest.NewRecorder()
+			p.handleAgentRun(rec, req)
+			if rec.Code != http.StatusOK {
+				t.Fatalf("handler: %d %s", rec.Code, rec.Body.String())
+			}
+			var response struct {
+				Model string `json:"model"`
+			}
+			_ = json.Unmarshal(rec.Body.Bytes(), &response)
+			if response.Model != "large" {
+				t.Fatalf("short approval downgraded task: %s", response.Model)
+			}
+			observed := receiveAgentRunLLMRequest(t, received)
+			if observed.Model != "large" {
+				t.Fatalf("actual LLM request downgraded: %s", observed.Model)
+			}
+			// Verify the actual model input, not just the HTTP response or helper output.
+			encoded, _ := json.Marshal(observed.Messages)
+			if !strings.Contains(string(encoded), "report rejected") || !strings.Contains(string(encoded), "prior analysis") {
+				t.Fatalf("actual model input lost repair context: %s", encoded)
+			}
+		})
+	}
+}
+
+func TestPriorDeclaredFailureNeverBecomesSuccessfulWriterState(t *testing.T) {
+	for _, response := range []string{
+		`{"content":[{"text":"{\"ok\":false,\"uid\":\"not-saved\"}"}]}`,
+		`{"isError":true,"content":[{"text":"{\"uid\":\"not-saved\"}"}]}`,
+	} {
+		raw := json.RawMessage(`[{"name":"mcp-grafana_update_dashboard","response":` + response + `}]`)
+		states := decodePriorState(t, compactPriorToolState(raw))
+		if len(states) != 1 || states[0]["ok"] != false || states[0]["uid"] != nil {
+			t.Fatalf("failed writer promoted: %#v", states)
+		}
+	}
+}
+
+func TestTaskHistoryCannotOverrideExplicitBase(t *testing.T) {
+	for _, stored := range []bool{false, true} {
+		t.Run(fmt.Sprint(stored), func(t *testing.T) {
+			llm, received := newAgentRunLLMServer(t)
+			defer llm.Close()
+			p := newAgentRunTestPlugin(t)
+			session, err := p.sessionStore.CreateSession(7, 2, "analysis", []SessionMessage{{Role: "user", Content: "Create a dashboard"}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			target := "/api/agent/run?model=base"
+			if stored {
+				model := "base"
+				if err := p.sessionStore.UpdateSession(session.ID, 7, 2, SessionUpdate{Model: &model}); err != nil {
+					t.Fatal(err)
+				}
+				target = "/api/agent/run"
+			}
+			req := newAgentRunRequest(t, llm.URL, target, fmt.Sprintf(`{"message":"同意","sessionId":%q}`, session.ID))
+			rec := httptest.NewRecorder()
+			p.handleAgentRun(rec, req)
+			if rec.Code != http.StatusOK {
+				t.Fatalf("handler: %d %s", rec.Code, rec.Body.String())
+			}
+			if actual := receiveAgentRunLLMRequest(t, received); actual.Model != "base" {
+				t.Fatalf("explicit base overridden: %s", actual.Model)
+			}
+		})
+	}
+}
