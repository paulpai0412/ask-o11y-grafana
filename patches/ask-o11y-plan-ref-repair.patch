+func TestLatestToolRefRecoversNestedPlanRef(t *testing.T) {
+	messages := []Message{
+		{Role: "assistant", ToolCalls: []ToolCall{{ID: "call-1", Function: FunctionCall{Name: "data-query-planner_plan_query"}}}},
+		{Role: "tool", ToolCallID: "call-1", Content: `{"ok":true,"refs":{"plan_ref":"artifact://run-1/query-plan"}}`},
+	}
+	if got := latestToolRef(messages, "data-query-planner_plan_query", "plan_ref"); got != "artifact://run-1/query-plan" {
+		t.Fatalf("plan ref = %q", got)
+	}
+}
+
+func TestLatestToolRefIgnoresFailedOrUnrelatedResults(t *testing.T) {
+	messages := []Message{
+		{Role: "assistant", ToolCalls: []ToolCall{{ID: "call-1", Function: FunctionCall{Name: "other_tool"}}, {ID: "call-2", Function: FunctionCall{Name: "data-query-planner_plan_query"}}}},
+		{Role: "tool", ToolCallID: "call-1", Content: `{"ok":true,"plan_ref":"artifact://wrong"}`},
+		{Role: "tool", ToolCallID: "call-2", Content: `{"ok":false,"plan_ref":"artifact://failed"}`},
+	}
+	if got := latestToolRef(messages, "data-query-planner_plan_query", "plan_ref"); got != "" {
+		t.Fatalf("failed/unrelated ref = %q", got)
+	}
+}
