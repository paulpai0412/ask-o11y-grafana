+func stringArg(value interface{}) string {
+	text, _ := value.(string)
+	return text
+}
+
+func latestToolRef(messages []Message, toolName, key string) string {
+	toolNames := make(map[string]string)
+	for _, message := range messages {
+		if message.Role != "assistant" {
+			continue
+		}
+		for _, call := range message.ToolCalls {
+			toolNames[call.ID] = call.Function.Name
+		}
+	}
+	for index := len(messages) - 1; index >= 0; index-- {
+		message := messages[index]
+		if message.Role != "tool" || toolNames[message.ToolCallID] != toolName {
+			continue
+		}
+		var result map[string]interface{}
+		if json.Unmarshal([]byte(message.Content), &result) != nil || result["ok"] != true {
+			continue
+		}
+		if ref, ok := result[key].(string); ok && strings.TrimSpace(ref) != "" {
+			return ref
+		}
+		refs, _ := result["refs"].(map[string]interface{})
+		if ref, ok := refs[key].(string); ok && strings.TrimSpace(ref) != "" {
+			return ref
+		}
+	}
+	return ""
+}
