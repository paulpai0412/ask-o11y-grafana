-			return "Scope approval interrupted; no scope granted", true, "approval_required"
-		}
-		if resolved.ResolvedAt == "" {
-			resolved.ResolvedAt = time.Now().UTC().Format(time.RFC3339)
-		}
-		a.send(ctx, events, SSEEvent{Type: "approval_resolved", Data: resolved})
-	}
-	if resolved.Decision != "approved" || resolved.ApprovalID != approval.ApprovalID {
-		return "Scope was not approved for this request", true, "approval_denied"
