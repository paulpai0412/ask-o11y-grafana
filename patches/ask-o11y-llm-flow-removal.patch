-func (s *analysisAutonomy) consumeScope(tc ToolCall, req LoopRequest) bool {
-	if s == nil || s.scope == nil || req.ForceGrafanaPublication {
-		return false
-	}
-	grant := s.scope
-	if grant.remaining <= 0 || grant.actor != [3]string{req.OrgID, req.UserID, req.SessionID} || !containsString(grant.Tools, tc.Function.Name) {
-		return false
-	}
-	var args map[string]interface{}
-	if json.Unmarshal([]byte(tc.Function.Arguments), &args) != nil || stringArg(args["frame_ref"]) != grant.FrameRef {
-		return false
-	}
-	allowed := map[string]bool{"frame_ref": true, "seed": true}
-	switch tc.Function.Name {
-	case "sandbox-analysis_execute_ml_contract":
-		allowed["contract_ref"] = true
-		if stringArg(args["contract_ref"]) != grant.planRef {
-			return false
-		}
-	case "sandbox-analysis_profile_dataset":
-	default:
-		return false
-	}
-	for key := range args {
-		if !allowed[key] {
-			return false
-		}
-	}
-	grant.remaining-- // failed/indeterminate attempts also consume budget, before dispatch
-	return true
-}
