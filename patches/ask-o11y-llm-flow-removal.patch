+)
+
+func TestLLMFlowAuthorizedCatalogAcrossConfirmation(t *testing.T) {
+	ctx := context.Background()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		tools := []map[string]interface{}{}
+		for i := 0; i < 30; i++ {
+			tools = append(tools, map[string]interface{}{"name": fmt.Sprintf("read_%d", i), "inputSchema": map[string]string{"type": "object"}})
+		}
+		json.NewEncoder(w).Encode(map[string]interface{}{"tools": tools})
+	}))
+	defer server.Close()
+	proxy := mcp.NewProxy(ctx, log.DefaultLogger)
+	defer proxy.Close()
+	config := mcp.ServerConfig{ID: "grafana-query", URL: server.URL, Type: "standard", Enabled: true}
+	if err := proxy.EnsureServer(config); err != nil {
+		t.Fatal(err)
+	}
+	calls := 0
+	llm := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		var request ChatCompletionRequest
+		if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
+			t.Error(err)
+		}
+		if len(request.Tools) != 30 {
+			t.Errorf("got %d tools, want all 30 authorized tools", len(request.Tools))
+		}
+		for _, tool := range request.Tools {
+			if tool.Function.Name == "ask_o11y_select_capabilities" || tool.Function.Name == "ask_o11y_approve_analysis_scope" {
+				t.Error("workflow-control tool leaked")
+			}
+		}
+		respondAsStream(w, ChatCompletionResponse{Choices: []Choice{{Message: Message{Role: "assistant", Content: "ready"}, FinishReason: "stop"}}})
+	}))
+	defer llm.Close()
+	loop := NewAgentLoop(NewLLMClient(log.DefaultLogger, &http.Client{Timeout: llmTimeout}), proxy, log.DefaultLogger)
+	for _, text := range []string{"preview", "confirm"} {
+		events := make(chan SSEEvent, 32)
+		go loop.Run(ctx, LoopRequest{Messages: []Message{{Role: "user", Content: text}}, GrafanaURL: llm.URL, UserRole: "Admin", OrgID: "1", MCPServers: []mcp.ServerConfig{config}}, events)
+		for _, event := range collectEvents(events) {
+			if event.Type == "error" {
+				t.Errorf("run failed: %+v", event)
+			}
+		}
+	}
+	if calls != 2 {
+		t.Fatalf("got %d model calls, want one per turn without preselection", calls)
+	}
+}
+
+func TestLLMFlowAnalysisDoesNotAskAgain(t *testing.T) {
+	ctx := context.Background()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/mcp/list-tools" {
+			json.NewEncoder(w).Encode(map[string]interface{}{"tools": []map[string]interface{}{{"name": "profile_dataset", "inputSchema": map[string]string{"type": "object"}}}})
+			return
+		}
+		json.NewEncoder(w).Encode(map[string]interface{}{"content": []map[string]string{{"type": "text", "text": "ok"}}})
+	}))
+	defer server.Close()
+	proxy := mcp.NewProxy(ctx, log.DefaultLogger)
+	defer proxy.Close()
+	config := mcp.ServerConfig{ID: "sandbox-analysis", URL: server.URL, Type: "standard", Enabled: true}
+	if err := proxy.EnsureServer(config); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := proxy.ListTools(); err != nil {
+		t.Fatal(err)
+	}
+	loop := NewAgentLoop(nil, proxy, log.DefaultLogger)
+	req := LoopRequest{UserRole: "Admin", OrgID: "1", MCPServers: []mcp.ServerConfig{config}, ApprovalPolicy: "approval-gated-writes", RegisterApproval: func(context.Context, ApprovalRequestEvent) (ApprovalWaitFunc, error) {
+		t.Error("analysis asked for redundant approval")
+		return nil, fmt.Errorf("unexpected approval")
+	}}
+	_, failed, kind := loop.executeToolWithApproval(ctx, make(chan SSEEvent, 4), ToolCall{Function: FunctionCall{Name: "sandbox-analysis_profile_dataset", Arguments: "{}"}}, req)
+	if failed {
+		t.Fatalf("analysis blocked: %s", kind)
+	}
+	req.MCPServers = []mcp.ServerConfig{{ID: "sandbox-analysis", Enabled: false}}
+	_, failed, _ = loop.executeToolWithApproval(ctx, make(chan SSEEvent, 4), ToolCall{Function: FunctionCall{Name: "sandbox-analysis_profile_dataset", Arguments: "{}"}}, req)
+	if !failed {
+		t.Fatal("disabled tool executed")
+	}
+}
