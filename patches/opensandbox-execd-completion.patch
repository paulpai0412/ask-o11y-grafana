--- /dev/null
+++ b/components/execd/pkg/jupyter/execute/completion_test.go
@@ -0,0 +1,114 @@
+package execute
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/stretchr/testify/require"
+)
+
+// Kernel status is request-scoped, not a global execution-complete signal.
+func TestCompletionBelongsToRequest(t *testing.T) {
+	for _, tc := range []struct {
+		name              string
+		idleFirst, failed bool
+	}{
+		{"reply-first", false, false}, {"idle-first", true, false}, {"error", true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			release := make(chan struct{})
+			server := createTestServer(t, func(conn *websocket.Conn) {
+				var request Message
+				if err := conn.ReadJSON(&request); err != nil {
+					t.Error(err)
+					return
+				}
+				send := func(kind MessageType, parent, channel string, content any) {
+					payload, _ := json.Marshal(content)
+					err := conn.WriteJSON(Message{Header: Header{MessageType: string(kind)}, ParentHeader: Header{MessageID: parent}, Channel: channel, Content: payload})
+					if err != nil {
+						t.Error(err)
+					}
+				}
+				id := request.Header.MessageID
+				// Foreign idle/reply/error and wrong-channel idle must not complete or contaminate this request.
+				send(MsgExecuteReply, "kernel-info", "shell", ExecuteReply{ExecutionCount: 99})
+				send(MsgStatus, "kernel-info", "iopub", StatusUpdate{ExecutionState: StateIdle})
+				send(MsgError, "kernel-info", "iopub", ErrorOutput{EName: "ForeignError"})
+				send(MsgStatus, id, "shell", StatusUpdate{ExecutionState: StateIdle})
+				reply := ExecuteReply{ExecutionCount: 1}
+				if tc.failed {
+					reply.ErrorOutput = ErrorOutput{EName: "ValueError", EValue: "probe"}
+				}
+				if tc.idleFirst {
+					if tc.failed {
+						send(MsgError, id, "iopub", reply.ErrorOutput)
+					}
+					send(MsgStatus, id, "iopub", StatusUpdate{ExecutionState: StateIdle})
+				} else {
+					send(MsgExecuteReply, id, "shell", reply)
+				}
+				send(MsgStream, id, "iopub", StreamOutput{Name: StreamStdout, Text: "waiting"})
+				<-release
+				if tc.idleFirst {
+					send(MsgExecuteReply, id, "shell", reply)
+				} else {
+					send(MsgStatus, id, "iopub", StatusUpdate{ExecutionState: StateIdle})
+				}
+			})
+			defer server.Close()
+			executor := NewExecutor("ws"+strings.TrimPrefix(server.URL, "http")+"/api/kernels/test/channels", nil)
+			require.NoError(t, executor.Connect())
+			defer executor.Disconnect()
+			results := make(chan *ExecutionResult, 10)
+			require.NoError(t, executor.ExecuteCodeStream("print('waiting')", results))
+			premature := false
+			waiting := false
+			for !waiting {
+				select {
+				case result, ok := <-results:
+					if !ok {
+						premature = true
+						waiting = true
+						break
+					}
+					if result.ExecutionTime > 0 {
+						premature = true
+					}
+					if result.Error != nil && result.Error.EName == "ForeignError" {
+						t.Error("foreign error leaked")
+					}
+					for _, stream := range result.Stream {
+						if stream.Text == "waiting" {
+							waiting = true
+						}
+					}
+				case <-time.After(time.Second):
+					t.Error("missing stream marker")
+					waiting = true
+				}
+			}
+			close(release)
+			require.False(t, premature, "completed before matching reply AND idle")
+			terminals := 0
+			for {
+				select {
+				case result, ok := <-results:
+					if !ok {
+						require.Equal(t, 1, terminals)
+						return
+					}
+					if result.ExecutionTime > 0 {
+						terminals++
+						require.Equal(t, tc.failed, result.Error != nil)
+					}
+				case <-time.After(time.Second):
+					t.Fatal("did not finish after matching reply and idle")
+				}
+			}
+		})
+	}
+}
