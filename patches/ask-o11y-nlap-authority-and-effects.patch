+var narrativeStylePattern = regexp.MustCompile(`^[A-Za-z0-9\s:;#.,%+\-]*$`)
+
+func validateNarrativeHTML(content string) error {
+	if strings.Contains(content, "![") {
+		return fmt.Errorf("text panels are narrative-only; use the Plotly plugin for images")
+	}
+	tokens := html.NewTokenizer(strings.NewReader(content))
+	for {
+		kind := tokens.Next()
+		if kind == html.ErrorToken {
+			if tokens.Err() == io.EOF {
+				return nil
+			}
+			return tokens.Err()
+		}
+		if kind != html.StartTagToken && kind != html.SelfClosingTagToken {
+			continue
+		}
+		token := tokens.Token()
+		if !strings.Contains(" div p span h1 h2 h3 h4 h5 h6 strong b em i ul ol li br hr blockquote code pre table thead tbody tr td th ", " "+token.Data+" ") {
+			return fmt.Errorf("text panels are narrative-only; use the Plotly plugin for images")
+		}
+		for _, attribute := range token.Attr {
+			if attribute.Key == "style" {
+				if !narrativeStylePattern.MatchString(attribute.Val) {
+					return fmt.Errorf("unsafe text panel style")
+				}
+			} else if !strings.Contains(" class title role aria-label lang dir colspan rowspan ", " "+attribute.Key+" ") {
+				return fmt.Errorf("text panel attribute is not narrative-only")
+			}
+		}
+	}
+}
+
+// All analysis images use the plugin, including PNG-only artifacts.
+func validateImagePanels(value interface{}) error {
+	switch node := value.(type) {
+	case map[string]interface{}:
+		// Also validate partial JSON patches, where the surrounding panel type is absent.
+		if content, ok := node["content"].(string); ok {
+			if err := validateNarrativeHTML(content); err != nil {
+				return err
+			}
+		}
+		if _, operation := node["op"]; operation {
+			if content, ok := node["value"].(string); ok {
+				if err := validateNarrativeHTML(content); err != nil {
+					return err
+				}
+			}
+		}
+		if _, artifact := node["askO11yArtifactId"]; artifact && node["type"] != "asko11y-plotly-panel" {
+			return fmt.Errorf("analysis image evidence must use asko11y-plotly-panel")
+		}
+		if node["type"] == "text" {
+			options, _ := node["options"].(map[string]interface{})
+			text, _ := options["content"].(string)
+			if err := validateNarrativeHTML(text); err != nil {
+				return err
+			}
+		}
+		for _, child := range node {
+			if err := validateImagePanels(child); err != nil {
+				return err
+			}
+		}
+	case []interface{}:
+		for _, child := range node {
+			if err := validateImagePanels(child); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
 
