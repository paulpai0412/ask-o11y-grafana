+func TestNLAPDashboardReceiptReplayAndUnknown(t *testing.T) {
+	t.Setenv("ASKO11Y_EFFECT_STORE", t.TempDir())
+	calls := 0
+	invoke := func() (*mcp.CallToolResult, error) { calls++; return &mcp.CallToolResult{}, nil }
+	for i := 0; i < 2; i++ {
+		if _, err := dashboardOnce([]byte("same-bound-operation"), invoke); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if calls != 1 {
+		t.Fatalf("writer executed %d times", calls)
+	}
+	_, err := dashboardOnce([]byte("unknown-operation"), func() (*mcp.CallToolResult, error) {
+		calls++
+		return nil, errors.New("lost connection after dispatch")
+	})
+	if err == nil {
