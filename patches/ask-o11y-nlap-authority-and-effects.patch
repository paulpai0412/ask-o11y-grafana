+package agent
+
+import (
+	"encoding/json"
+	"errors"
+)
+
+func validateInspectionTransport(name string, args map[string]interface{}) error {
+	// Message.Content is text-only; a vision receipt would falsely attest image delivery.
+	if name == "artifact-bridge_inspect_report_artifacts" && args["mode"] != "spec" {
+		return errors.New(`{"ok":false,"step":"inspect_report_artifacts","error":"HOST_VISION_TRANSPORT_UNAVAILABLE","recoverable":true,"instruction":"Use mode=spec and visual_observation=null. This host carries text tool results only; browser rendering is verified separately."}`)
+	}
+	return nil
+}
+
+func requiresExactAnalysisApproval(name string) bool {
+	switch name {
+	case "grafana-query_execute_planned_query", "sandbox-analysis_execute_ml_contract", "sandbox-analysis_profile_dataset", "sandbox-analysis_execute_python_analysis", "sandbox-analysis_execute_python_preprocessing", "sandbox-analysis_revise_python_analysis", "mcp-grafana_update_dashboard", "artifact-bridge_grant_artifact_reuse":
+		return true
+	default:
+		return false
+	}
+}
+
+// Bind trusted refs before emitting the event and asking approval, not after approval.
+func bindTrustedToolCall(call ToolCall, req LoopRequest) ToolCall {
+	var args map[string]interface{}
+	if json.Unmarshal([]byte(call.Function.Arguments), &args) != nil || args == nil {
+		return call
+	}
+	if bindUploadDatasetArgument(call.Function.Name, args, req.UploadDatasetID) != nil {
+		return call
+	}
+	bind := func(key, value string) {
+		current, exists := args[key]
+		if value != "" && (!exists || current == nil || current == "") {
+			args[key] = value
+		}
+	}
+	switch call.Function.Name {
+	case "grafana-query_execute_planned_query":
+		bind("plan_ref", req.OpaquePlanRef)
+	case "sandbox-analysis_execute_ml_contract":
+		bind("contract_ref", req.OpaquePlanRef)
+		bind("frame_ref", req.OpaqueFrameRef)
+	}
+	if encoded, err := json.Marshal(args); err == nil {
+		call.Function.Arguments = string(encoded)
+	}
+	return call
+}
