+	if err != nil || result == nil || calls != 1 {
+		t.Fatalf("completion recovery failed: %v", err)
+	}
+	payload, err := json.Marshal(dashboardCompletion{OperationID: "other-actor-input", Result: &mcp.CallToolResult{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(operation, "completion.json"), payload, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(filepath.Join(operation, "response.json")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := dashboardOnce(identity, func() (*mcp.CallToolResult, error) { t.Fatal("writer redispatched"); return nil, nil }); err == nil {
+		t.Fatal("mismatched completion accepted")
