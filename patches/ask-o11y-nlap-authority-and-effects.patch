new file mode 100644
--- /dev/null
+++ b/pkg/agent/effect_receipts.go
@@ -0,0 +1,126 @@
+package agent
+
+import (
+	"consensys-asko11y-app/pkg/mcp"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+func syncReceiptDirectory(path string) error {
+	file, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	return file.Sync()
+}
+
+type dashboardCompletion struct {
+	OperationID string              `json:"operation_id"`
+	Result      *mcp.CallToolResult `json:"result"`
+}
+
+func persistDashboardReceipt(operation, name string, payload []byte) error {
+	file, err := os.CreateTemp(operation, ".receipt-*")
+	if err != nil {
+		return err
+	}
+	temporary := file.Name()
+	defer os.Remove(temporary)
+	_, writeErr := file.Write(payload)
+	syncErr := file.Sync()
+	closeErr := file.Close()
+	if err := errors.Join(writeErr, syncErr, closeErr); err != nil {
+		return err
+	}
+	if err := os.Rename(temporary, filepath.Join(operation, name)); err != nil {
+		return err
+	}
+	return syncReceiptDirectory(operation)
+}
+
+// reconcileDashboardReceipt trusts only a durable completion from this exact actor/input identity.
+// No completion evidence means indeterminate, never permission to write again.
+func reconcileDashboardReceipt(operation string) (*mcp.CallToolResult, error) {
+	payload, err := os.ReadFile(filepath.Join(operation, "completion.json"))
+	if err != nil {
+		return nil, fmt.Errorf("dashboard operation %s running or indeterminate; no completion evidence, do not redispatch", filepath.Base(operation))
+	}
+	var completion dashboardCompletion
+	if err := json.Unmarshal(payload, &completion); err != nil {
+		return nil, err
+	}
+	if completion.OperationID != filepath.Base(operation) || completion.Result == nil || completion.Result.IsError {
+		return nil, fmt.Errorf("dashboard completion identity/outcome is invalid")
+	}
+	response, err := json.Marshal(completion.Result)
+	if err != nil {
+		return nil, err
+	}
+	if err := persistDashboardReceipt(operation, "response.json", response); err != nil {
+		return nil, err
+	}
+	return completion.Result, nil
+}
+
+// dashboardOnce reserves durably before writing. Unknown outcomes require reconciliation.
+func dashboardOnce(identity []byte, invoke func() (*mcp.CallToolResult, error)) (*mcp.CallToolResult, error) {
+	root := os.Getenv("ASKO11Y_EFFECT_STORE")
+	if root == "" {
+		data := os.Getenv("GF_PATHS_DATA")
+		if data == "" {
+			return nil, fmt.Errorf("dashboard writer requires a persistent ASKO11Y_EFFECT_STORE or GF_PATHS_DATA")
+		}
+		root = filepath.Join(data, "ask-o11y-operations")
+	}
+	if err := os.MkdirAll(root, 0700); err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256(identity)
+	operation := filepath.Join(root, hex.EncodeToString(digest[:]))
+	response := filepath.Join(operation, "response.json")
+	if err := os.Mkdir(operation, 0700); err != nil {
+		if !errors.Is(err, os.ErrExist) {
+			return nil, err
+		}
+		payload, err := os.ReadFile(response)
+		if errors.Is(err, os.ErrNotExist) {
+			return reconcileDashboardReceipt(operation)
+		}
+		if err != nil {
+			return nil, err
+		}
+		var result mcp.CallToolResult
+		if err := json.Unmarshal(payload, &result); err != nil {
+			return nil, fmt.Errorf("dashboard receipt invalid: %w", err)
+		}
+		return &result, nil
+	}
+	if err := syncReceiptDirectory(root); err != nil {
+		return nil, err
+	}
+	result, err := invoke()
+	if err != nil || result == nil || result.IsError {
+		return result, err
+	}
+	payload, err := json.Marshal(result)
+	if err != nil {
+		return nil, err
+	}
+	completion, err := json.Marshal(dashboardCompletion{OperationID: filepath.Base(operation), Result: result})
+	if err != nil {
+		return nil, err
+	}
+	if err := persistDashboardReceipt(operation, "completion.json", completion); err != nil {
+		return nil, err
+	}
+	if err := persistDashboardReceipt(operation, "response.json", payload); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
