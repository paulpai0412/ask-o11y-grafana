+func compactPriorToolState(raw json.RawMessage) string {
+	if len(raw) == 0 {
+		return ""
+	}
+	var calls []map[string]interface{}
+	if err := json.Unmarshal(raw, &calls); err != nil {
+		return ""
+	}
+	states := make([]map[string]interface{}, 0, len(calls))
+	for _, call := range calls {
+		if errorText, _ := call["error"].(string); errorText != "" {
+			continue
+		}
+		response, ok := call["response"].(map[string]interface{})
+		if !ok {
+			continue
+		}
+		content, ok := response["content"].([]interface{})
+		if !ok {
+			continue
+		}
+		for _, blockValue := range content {
+			block, ok := blockValue.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			text, _ := block["text"].(string)
+			var result map[string]interface{}
+			if text == "" || json.Unmarshal([]byte(text), &result) != nil || result["ok"] != true {
+				continue
+			}
+			state := map[string]interface{}{"tool": call["name"]}
+			for key, value := range result {
+				if key == "refs" || key == "run_id" || key == "step" || key == "dataset_id" || key == "datasource_uid" || key == "selected_fields" || key == "output_summary" || strings.HasSuffix(key, "_ref") || strings.HasSuffix(key, "_uid") || strings.HasSuffix(key, "_url") || strings.HasSuffix(key, "_slug") {
+					state[key] = value
+				}
+			}
+			states = append(states, state)
+		}
+	}
+	if len(states) == 0 {
+		return ""
+	}
+	encoded, err := json.Marshal(states)
+	if err != nil {
+		return ""
+	}
+	if len(encoded) > 16*1024 {
+		encoded = encoded[:16*1024]
+	}
+	return "[Prior successful opaque tool state. Reuse exact refs only when their provenance matches the current intent; never reconstruct them: " + string(encoded) + "]"
+}
