+func isExecutionResult(content string) bool {
+	var result map[string]interface{}
+	if json.Unmarshal([]byte(content), &result) != nil || result["ok"] != true {
+		return false
+	}
+	step, _ := result["step"].(string)
+	return strings.HasPrefix(step, "execute_")
+}
+
+func isGrafanaPreviewResult(content string) bool {
+	var result map[string]interface{}
+	if json.Unmarshal([]byte(content), &result) != nil || result["ok"] != true || result["step"] != "create_temporary_dashboard_preview" {
+		return false
+	}
+	previewURL, _ := result["grafana_preview_url"].(string)
+	return previewURL != ""
+}
