+func (a *AgentLoop) selectRelevantTools(ctx context.Context, req LoopRequest, tools []mcp.Tool) ([]mcp.Tool, bool) {
+	if len(tools) == 0 {
+		return tools, false
+	}
+	type catalogEntry struct {
+		Name        string `json:"name"`
+		Description string `json:"description,omitempty"`
+	}
+	catalog := make([]catalogEntry, 0, len(tools))
+	for _, tool := range tools {
+		description := tool.Description
+		if len(description) > 300 {
+			description = description[:300]
+		}
+		catalog = append(catalog, catalogEntry{Name: tool.Name, Description: description})
+	}
+	catalogJSON, err := json.Marshal(catalog)
+	if err != nil {
+		return tools, false
+	}
+	conversation := make([]Message, 0, 6)
+	start := len(req.Messages) - 6
+	if start < 0 {
+		start = 0
+	}
+	for _, message := range req.Messages[start:] {
+		if message.Role == "user" || message.Role == "assistant" || (message.Role == "system" && strings.HasPrefix(message.Content, "[Prior successful opaque tool state.")) {
+			conversation = append(conversation, Message{Role: message.Role, Content: message.Content})
+		}
+	}
+	conversationJSON, err := json.Marshal(conversation)
+	if err != nil {
+		return tools, false
+	}
+	selectionPrompt := "You are the tool-capability selector for the same Ask O11y planner. Select only tools plausibly needed for the current user turn and its direct safe follow-up work. Do not invent identifiers or execute tools. Preserve optional compositions; do not impose a workflow. Return only JSON: {\"tools\":[exact names from catalog, at most 24],\"prepare_grafana_preview_after_execution\":boolean}. Set the boolean true only when this current turn authorizes data/analysis execution and prior/current intent explicitly requests Grafana, Dashboard, or a Grafana preview. That turn must create a temporary visually inspectable Grafana Preview after successful execution, but must not formally publish it. It is false for initial Analysis Preview, pure analysis, and the later turn that explicitly confirms publication of an existing Grafana Preview.\nConversation: " + string(conversationJSON) + "\nCatalog: " + string(catalogJSON)
+	selectionReq := ChatCompletionRequest{
+		Model:     req.Model,
+		Messages:  []Message{{Role: "system", Content: selectionPrompt}},
+		MaxTokens: 1024,
+	}
+	resp, err := a.chatCompletionWithFallback(ctx, selectionReq, req)
+	if err != nil || len(resp.Choices) == 0 {
+		a.logger.Warn("Dynamic tool selection failed; retaining authorized tool set", "error", err)
+		return tools, false
+	}
+	content := strings.TrimSpace(resp.Choices[0].Message.Content)
+	if start := strings.Index(content, "{"); start >= 0 {
+		if end := strings.LastIndex(content, "}"); end >= start {
+			content = content[start : end+1]
+		}
+	}
+	var decision struct {
+		Tools                               []string `json:"tools"`
+		PrepareGrafanaPreviewAfterExecution bool     `json:"prepare_grafana_preview_after_execution"`
+	}
+	if err := json.Unmarshal([]byte(content), &decision); err != nil || len(decision.Tools) > maxSelectedTools {
+		a.logger.Warn("Dynamic tool selection returned invalid JSON; retaining authorized tool set", "response", content)
+		return tools, false
+	}
+	names := decision.Tools
+	selected := make(map[string]struct{}, len(names))
+	for _, name := range names {
+		selected[name] = struct{}{}
+	}
+	for _, server := range req.MCPServers {
+		prefix := server.ID + "_"
+		serverSelected := false
+		for name := range selected {
+			if strings.HasPrefix(name, prefix) {
+				serverSelected = true
+				break
+			}
+		}
+		if serverSelected {
+			for _, tool := range tools {
+				if strings.HasPrefix(tool.Name, prefix) {
+					selected[tool.Name] = struct{}{}
+				}
+			}
+		}
+	}
+	previewToolAvailable := false
+	if decision.PrepareGrafanaPreviewAfterExecution {
+		for _, tool := range tools {
+			switch {
+			case strings.HasSuffix(tool.Name, "_list_visualization_capabilities"), strings.HasSuffix(tool.Name, "_prepare_dashboard_write"), strings.HasSuffix(tool.Name, "_create_temporary_dashboard_preview"):
+				selected[tool.Name] = struct{}{}
+				previewToolAvailable = previewToolAvailable || strings.HasSuffix(tool.Name, "_create_temporary_dashboard_preview")
+			case strings.HasSuffix(tool.Name, "_create_dashboard_from_artifacts"):
+				delete(selected, tool.Name)
+			}
+		}
+	}
+	filtered := make([]mcp.Tool, 0, len(selected))
+	for _, tool := range tools {
+		if _, ok := selected[tool.Name]; ok {
+			filtered = append(filtered, tool)
+		}
+	}
+	if len(names) > 0 && len(filtered) == 0 {
+		a.logger.Warn("Dynamic tool selection chose no known tools; retaining authorized tool set")
+		return tools, false
+	}
+	preparePreview := decision.PrepareGrafanaPreviewAfterExecution && previewToolAvailable
+	a.logger.Info("Dynamically selected tools", "available", len(tools), "selected", len(filtered), "prepareGrafanaPreviewAfterExecution", preparePreview)
+	return filtered, preparePreview
+}
