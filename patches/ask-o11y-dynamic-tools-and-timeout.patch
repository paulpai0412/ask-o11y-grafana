--- /dev/null
+++ b/pkg/agent/dashboard_resolver_test.go
@@ -0,0 +1,50 @@
+package agent
+
+import "testing"
+
+func TestPrepareBuiltInDashboardArgsEnforcesPreviewTag(t *testing.T) {
+	loop := &AgentLoop{}
+	args := map[string]interface{}{"dashboard": map[string]interface{}{"title": "Dashboard", "tags": []interface{}{"other", previewDashboardTag}, "panels": []interface{}{}}}
+	resolved, err := loop.prepareBuiltInDashboardArgs(args, LoopRequest{ForceGrafanaPreview: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	dashboard := resolved["dashboard"].(map[string]interface{})
+	tags := dashboard["tags"].([]interface{})
+	if len(tags) != 2 || tags[0] != previewDashboardTag || tags[1] != "other" {
+		t.Fatalf("tags = %v, want [%s other]", tags, previewDashboardTag)
+	}
+}
+
+func TestPrepareBuiltInDashboardArgsNormalizesPublicationPatch(t *testing.T) {
+	loop := &AgentLoop{}
+	resolved, err := loop.prepareBuiltInDashboardArgs(map[string]interface{}{"uid": "existing", "operations": []interface{}{map[string]interface{}{"op": "remove", "path": "$.askO11yPreview"}}}, LoopRequest{ForceGrafanaPublication: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	operations := resolved["operations"].([]interface{})
+	operation := operations[0].(map[string]interface{})
+	if len(operations) != 1 || operation["op"] != "remove" || operation["path"] != "$.tags[0]" {
+		t.Fatalf("operations = %v", operations)
+	}
+}
+
+func TestPrepareBuiltInDashboardArgsRejectsPreviewPatch(t *testing.T) {
+	loop := &AgentLoop{}
+	if _, err := loop.prepareBuiltInDashboardArgs(map[string]interface{}{"uid": "existing", "operations": []interface{}{}}, LoopRequest{ForceGrafanaPreview: true}); err == nil {
+		t.Fatal("preview patch unexpectedly accepted")
+	}
+}
+
+func TestPrepareBuiltInDashboardArgsRejectsOpaqueNonPanelPatch(t *testing.T) {
+	loop := &AgentLoop{}
+	args := map[string]interface{}{
+		"uid": "existing",
+		"operations": []interface{}{map[string]interface{}{
+			"op": "add", "path": "$.tags/-", "value": map[string]interface{}{"$plan_ref": "artifact://run/query-plan"},
+		}},
+	}
+	if _, err := loop.prepareBuiltInDashboardArgs(args, LoopRequest{}); err == nil {
+		t.Fatal("opaque non-panel patch unexpectedly bypassed resolver")
+	}
+}
