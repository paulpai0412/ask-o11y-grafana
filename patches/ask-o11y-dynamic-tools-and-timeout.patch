diff --git a/pkg/agent/dashboard_resolver.go b/pkg/agent/dashboard_resolver.go
new file mode 100644
index 0000000..2469cf6
--- /dev/null
+++ b/pkg/agent/dashboard_resolver.go
@@ -0,0 +1,149 @@
+package agent
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+const artifactBridgeResolveTool = "artifact-bridge_resolve_dashboard_refs"
+const previewDashboardTag = "ask-o11y-preview"
+
+func hasOpaqueDashboardRefs(value interface{}) (bool, error) {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return false, fmt.Errorf("dashboard JSON is invalid: %w", err)
+	}
+	return strings.Contains(string(encoded), `"$plan_ref"`) || strings.Contains(string(encoded), `"$execution_ref"`), nil
+}
+
+func (a *AgentLoop) resolveDashboardBindings(dashboard map[string]interface{}, req LoopRequest) (map[string]interface{}, error) {
+	hasRefs, err := hasOpaqueDashboardRefs(dashboard)
+	if err != nil || !hasRefs {
+		return dashboard, err
+	}
+	result, err := a.mcpProxy.CallToolWithContext(artifactBridgeResolveTool, map[string]interface{}{"dashboard": dashboard}, req.OrgID, req.OrgName, req.ScopeOrgID)
+	if err != nil {
+		return nil, fmt.Errorf("artifact binding resolution failed: %w", err)
+	}
+	if result.IsError {
+		return nil, fmt.Errorf("artifact binding resolution failed: %s", extractText(result))
+	}
+	var resolved struct {
+		OK        bool                   `json:"ok"`
+		Error     string                 `json:"error"`
+		Dashboard map[string]interface{} `json:"dashboard"`
+	}
+	if err := json.Unmarshal([]byte(extractText(result)), &resolved); err != nil {
+		return nil, fmt.Errorf("artifact bridge returned invalid JSON: %w", err)
+	}
+	if !resolved.OK || resolved.Dashboard == nil {
+		return nil, fmt.Errorf("artifact bridge rejected dashboard bindings: %s", resolved.Error)
+	}
+	return resolved.Dashboard, nil
+}
+
+func (a *AgentLoop) resolvePatchBindings(args map[string]interface{}, req LoopRequest) (map[string]interface{}, error) {
+	hasRefs, err := hasOpaqueDashboardRefs(args)
+	if err != nil || !hasRefs {
+		return args, err
+	}
+	operations, ok := args["operations"].([]interface{})
+	if !ok {
+		return nil, fmt.Errorf("opaque dashboard bindings require a complete dashboard or panel add/replace operation")
+	}
+	output := make(map[string]interface{}, len(args))
+	for key, value := range args {
+		output[key] = value
+	}
+	resolvedOperations := make([]interface{}, 0, len(operations))
+	for index, rawOperation := range operations {
+		operation, ok := rawOperation.(map[string]interface{})
+		if !ok {
+			return nil, fmt.Errorf("dashboard operation %d is invalid", index)
+		}
+		value, hasValue := operation["value"]
+		hasValueRefs, err := hasOpaqueDashboardRefs(value)
+		if err != nil {
+			return nil, err
+		}
+		if !hasValueRefs {
+			resolvedOperations = append(resolvedOperations, operation)
+			continue
+		}
+		path, _ := operation["path"].(string)
+		if !hasValue || !strings.HasPrefix(strings.TrimSpace(path), "$.panels/") {
+			return nil, fmt.Errorf("opaque dashboard bindings in patch mode require a complete panel add/replace operation")
+		}
+		panel, ok := value.(map[string]interface{})
+		if !ok {
+			return nil, fmt.Errorf("opaque dashboard panel operation %d requires an object value", index)
+		}
+		resolved, err := a.resolveDashboardBindings(map[string]interface{}{"panels": []interface{}{panel}}, req)
+		if err != nil {
+			return nil, err
+		}
+		panels, ok := resolved["panels"].([]interface{})
+		if !ok || len(panels) != 1 {
+			return nil, fmt.Errorf("artifact bridge returned an invalid resolved panel")
+		}
+		resolvedPanel, ok := panels[0].(map[string]interface{})
+		if !ok {
+			return nil, fmt.Errorf("artifact bridge returned an invalid resolved panel")
+		}
+		resolvedOperation := make(map[string]interface{}, len(operation))
+		for key, item := range operation {
+			resolvedOperation[key] = item
+		}
+		resolvedOperation["value"] = resolvedPanel
+		resolvedOperations = append(resolvedOperations, resolvedOperation)
+	}
+	output["operations"] = resolvedOperations
+	return output, nil
+}
+
+func (a *AgentLoop) prepareBuiltInDashboardArgs(args map[string]interface{}, req LoopRequest) (map[string]interface{}, error) {
+	dashboard, hasDashboard := args["dashboard"].(map[string]interface{})
+	if req.ForceGrafanaPreview && !hasDashboard {
+		return nil, fmt.Errorf("Grafana Preview creation requires one complete dashboard JSON; patch mode is reserved for later confirmed publication")
+	}
+	if req.ForceGrafanaPublication {
+		if hasDashboard {
+			return nil, fmt.Errorf("confirmed publication must patch the reviewed Dashboard UID rather than replace its JSON")
+		}
+		uid, _ := args["uid"].(string)
+		if strings.TrimSpace(uid) == "" {
+			return nil, fmt.Errorf("confirmed publication requires the reviewed Dashboard UID")
+		}
+		output := make(map[string]interface{}, len(args)+1)
+		for key, value := range args {
+			output[key] = value
+		}
+		output["operations"] = []interface{}{map[string]interface{}{"op": "remove", "path": "$.tags[0]"}}
+		output["message"] = "Publish reviewed Ask O11y Grafana Preview"
+		return output, nil
+	}
+	if !hasDashboard {
+		return a.resolvePatchBindings(args, req)
+	}
+	if req.ForceGrafanaPreview {
+		tags, _ := dashboard["tags"].([]interface{})
+		normalized := []interface{}{previewDashboardTag}
+		for _, tag := range tags {
+			if tag != previewDashboardTag {
+				normalized = append(normalized, tag)
+			}
+		}
+		dashboard["tags"] = normalized
+	}
+	resolved, err := a.resolveDashboardBindings(dashboard, req)
+	if err != nil {
+		return nil, err
+	}
+	output := make(map[string]interface{}, len(args))
+	for key, value := range args {
+		output[key] = value
+	}
+	output["dashboard"] = resolved
+	return output, nil
+}
