diff --git a/pkg/agent/skill_registry.go b/pkg/agent/skill_registry.go
new file mode 100644
index 0000000..8663631
--- /dev/null
+++ b/pkg/agent/skill_registry.go
@@ -0,0 +1,103 @@
+package agent
+
+import (
+	"crypto/sha256"
+	"embed"
+	"fmt"
+	"io/fs"
+	"path"
+	"sort"
+	"strings"
+)
+
+const maxSelectedSkills = 2
+const maxSkillContextBytes = 32 * 1024
+
+//go:embed skills
+var embeddedSkills embed.FS
+
+type agentSkill struct {
+	Name        string
+	Description string
+	Content     string
+	SHA256      string
+}
+
+func availableAgentSkills() []agentSkill {
+	entries, err := fs.ReadDir(embeddedSkills, "skills")
+	if err != nil {
+		return nil
+	}
+	var skills []agentSkill
+	for _, entry := range entries {
+		if !entry.IsDir() {
+			continue
+		}
+		root := path.Join("skills", entry.Name())
+		body, err := embeddedSkills.ReadFile(path.Join(root, "SKILL.md"))
+		if err != nil {
+			continue
+		}
+		name, description := skillFrontmatter(string(body))
+		if name == "" || description == "" {
+			continue
+		}
+		content := string(body)
+		_ = fs.WalkDir(embeddedSkills, path.Join(root, "references"), func(filename string, item fs.DirEntry, walkErr error) error {
+			if walkErr != nil || item.IsDir() || !strings.HasSuffix(filename, ".md") {
+				return nil
+			}
+			reference, readErr := embeddedSkills.ReadFile(filename)
+			if readErr == nil && len(content)+len(reference) <= maxSkillContextBytes {
+				content += "\n\n---\nReference: " + strings.TrimPrefix(filename, root+"/") + "\n\n" + string(reference)
+			}
+			return nil
+		})
+		hash := sha256.Sum256([]byte(content))
+		skills = append(skills, agentSkill{Name: name, Description: description, Content: content, SHA256: fmt.Sprintf("%x", hash[:])})
+	}
+	sort.Slice(skills, func(i, j int) bool { return skills[i].Name < skills[j].Name })
+	return skills
+}
+
+func skillFrontmatter(content string) (string, string) {
+	if !strings.HasPrefix(content, "---\n") {
+		return "", ""
+	}
+	end := strings.Index(content[4:], "\n---\n")
+	if end < 0 {
+		return "", ""
+	}
+	var name, description string
+	for _, line := range strings.Split(content[4:4+end], "\n") {
+		key, value, ok := strings.Cut(line, ":")
+		if !ok {
+			continue
+		}
+		switch strings.TrimSpace(key) {
+		case "name":
+			name = strings.Trim(strings.TrimSpace(value), `"'`)
+		case "description":
+			description = strings.Trim(strings.TrimSpace(value), `"'`)
+		}
+	}
+	return name, description
+}
+
+func selectedSkillMessages(names []string) []Message {
+	if len(names) == 0 {
+		return nil
+	}
+	selected := make(map[string]struct{}, len(names))
+	for _, name := range names {
+		selected[name] = struct{}{}
+	}
+	var messages []Message
+	for _, skill := range availableAgentSkills() {
+		if _, ok := selected[skill.Name]; !ok {
+			continue
+		}
+		messages = append(messages, Message{Role: "system", Content: fmt.Sprintf("[Selected Agent Skill: %s sha256=%s]\n%s\n[End Selected Agent Skill]", skill.Name, skill.SHA256, skill.Content)})
+	}
+	return messages
+}
