+func isExecutionResult(content string) bool {
+	var result map[string]interface{}
+	if json.Unmarshal([]byte(content), &result) != nil || result["ok"] != true {
+		return false
+	}
+	step, _ := result["step"].(string)
+	return strings.HasPrefix(step, "execute_")
+}
+
+func conversationSupportsDatasourceFamily(messages []Message, family string) bool {
+	aliases := map[string][]string{
+		"loki":       {"loki", "log", "logs", "logql"},
+		"prometheus": {"prometheus", "promql"},
+		"tempo":      {"tempo", "trace", "traces", "traceql"},
+		"pyroscope":  {"pyroscope", "profile", "profiles", "profiling"},
+	}
+	for _, message := range messages {
+		if message.Role != "user" && !(message.Role == "system" && strings.HasPrefix(message.Content, "[Prior successful opaque tool state.")) {
+			continue
+		}
+		normalized := strings.Map(func(value rune) rune {
+			if value >= 'a' && value <= 'z' || value >= '0' && value <= '9' {
+				return value
+			}
+			if value >= 'A' && value <= 'Z' {
+				return value + ('a' - 'A')
+			}
+			return ' '
+		}, message.Content)
+		words := make(map[string]struct{})
+		for _, word := range strings.Fields(normalized) {
+			words[word] = struct{}{}
+		}
+		for _, alias := range aliases[family] {
+			if _, ok := words[alias]; ok {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (a *AgentLoop) selectRelevantTools(ctx context.Context, req LoopRequest, tools []mcp.Tool) ([]mcp.Tool, []Message, bool, bool) {
+	if len(tools) == 0 {
+		return tools, nil, false, false
+	}
+	type catalogEntry struct {
+		Name        string `json:"name"`
+		Description string `json:"description,omitempty"`
+	}
+	catalog := make([]catalogEntry, 0, len(tools))
+	for _, tool := range tools {
+		description := tool.Description
+		if len(description) > 300 {
+			description = description[:300]
+		}
+		catalog = append(catalog, catalogEntry{Name: tool.Name, Description: description})
+	}
+	skillCatalog := make([]catalogEntry, 0, len(availableAgentSkills()))
+	for _, skill := range availableAgentSkills() {
+		skillCatalog = append(skillCatalog, catalogEntry{Name: skill.Name, Description: skill.Description})
+	}
+	catalogJSON, err := json.Marshal(catalog)
+	if err != nil {
+		return tools, nil, false, false
+	}
+	skillCatalogJSON, err := json.Marshal(skillCatalog)
+	if err != nil {
+		return tools, nil, false, false
+	}
+	conversation := make([]Message, 0, 6)
+	start := len(req.Messages) - 6
+	if start < 0 {
+		start = 0
+	}
+	for _, message := range req.Messages[start:] {
+		if message.Role == "user" || message.Role == "assistant" || (message.Role == "system" && strings.HasPrefix(message.Content, "[Prior successful opaque tool state.")) {
+			conversation = append(conversation, Message{Role: message.Role, Content: message.Content})
+		}
+	}
+	conversationJSON, err := json.Marshal(conversation)
+	if err != nil {
+		return tools, nil, false, false
+	}
+	selectionPrompt := "You are the capability selector for the same Ask O11y planner. Select only tools and Agent Skills plausibly needed for this turn and its direct safe follow-up. Skills are advisory knowledge; live tool schemas remain authoritative. Preserve optional compositions and do not impose an analysis workflow. Datasource-family tools (for example Loki or Prometheus query tools) may be selected only when the conversation explicitly requests that family or contains a real discovered datasource UID of that type; never select them for a registered-dataset analysis merely to probe capabilities. Return only JSON: {\"tools\":[exact tool names, at most 24],\"skills\":[exact skill names, at most 2],\"datasource_families\":[explicitly evidenced values from registered,loki,prometheus,tempo,pyroscope],\"prepare_grafana_preview_after_execution\":boolean,\"publish_reviewed_grafana_preview\":boolean}. Use datasource family registered for named registered-dataset analysis; include Loki, Prometheus, Tempo, or Pyroscope only when explicitly requested or proven by a discovered datasource UID. Set prepare true only when this turn authorizes data/analysis execution and prior/current intent requests Grafana, Dashboard, or a Grafana preview. Set publish true only when the user explicitly confirms publication of the already visible Grafana Preview; the booleans are mutually exclusive. Preview creation must use a complete preview-tagged dashboard; publication must patch the same UID without rerunning query or analysis.\nConversation: " + string(conversationJSON) + "\nTool catalog: " + string(catalogJSON) + "\nSkill catalog: " + string(skillCatalogJSON)
+	selectionReq := ChatCompletionRequest{Model: req.Model, Messages: []Message{{Role: "system", Content: selectionPrompt}}, MaxTokens: 1024}
+	resp, err := a.chatCompletionWithFallback(ctx, selectionReq, req)
+	if err != nil || len(resp.Choices) == 0 {
+		a.logger.Warn("Dynamic capability selection failed; retaining authorized tool set", "error", err)
+		return tools, nil, false, false
+	}
+	content := strings.TrimSpace(resp.Choices[0].Message.Content)
+	if start := strings.Index(content, "{"); start >= 0 {
+		if end := strings.LastIndex(content, "}"); end >= start {
+			content = content[start : end+1]
+		}
+	}
+	var decision struct {
+		Tools                               []string `json:"tools"`
+		Skills                              []string `json:"skills"`
+		DatasourceFamilies                  []string `json:"datasource_families"`
+		PrepareGrafanaPreviewAfterExecution bool     `json:"prepare_grafana_preview_after_execution"`
+		PublishReviewedGrafanaPreview       bool     `json:"publish_reviewed_grafana_preview"`
+	}
+	if err := json.Unmarshal([]byte(content), &decision); err != nil || len(decision.Tools) > maxSelectedTools || len(decision.Skills) > maxSelectedSkills || len(decision.DatasourceFamilies) > 5 {
+		a.logger.Warn("Dynamic capability selection returned invalid JSON; retaining authorized tool set", "response", content)
+		return tools, nil, false, false
+	}
+	selected := make(map[string]struct{}, len(decision.Tools))
+	families := make(map[string]struct{}, len(decision.DatasourceFamilies))
+	for _, family := range decision.DatasourceFamilies {
+		families[strings.ToLower(family)] = struct{}{}
+	}
+	for _, name := range decision.Tools {
+		lowerName := strings.ToLower(name)
+		requiredFamily := ""
+		for _, family := range []string{"loki", "prometheus", "tempo", "pyroscope"} {
+			if strings.Contains(lowerName, "_"+family+"_") || strings.HasSuffix(lowerName, "_"+family) {
+				requiredFamily = family
+				break
+			}
+		}
+		if requiredFamily != "" {
+			if _, ok := families[requiredFamily]; !ok || !conversationSupportsDatasourceFamily(req.Messages, requiredFamily) {
+				continue
+			}
+		}
+		selected[name] = struct{}{}
+	}
+	for _, server := range req.MCPServers {
+		prefix := server.ID + "_"
+		serverSelected := false
+		for name := range selected {
+			if strings.HasPrefix(name, prefix) {
+				serverSelected = true
+				break
+			}
+		}
+		if serverSelected {
+			for _, tool := range tools {
+				if strings.HasPrefix(tool.Name, prefix) {
+					selected[tool.Name] = struct{}{}
+				}
+			}
+		}
+	}
+	previewToolAvailable := false
+	if decision.PrepareGrafanaPreviewAfterExecution && decision.PublishReviewedGrafanaPreview {
+		return tools, selectedSkillMessages(decision.Skills), false, false
+	}
+	if decision.PrepareGrafanaPreviewAfterExecution {
+		for _, tool := range tools {
+			if tool.Name == "mcp-grafana_update_dashboard" {
+				selected[tool.Name] = struct{}{}
+				previewToolAvailable = true
+			}
+		}
+		if !containsString(decision.Skills, "dashboarding") {
+			decision.Skills = append(decision.Skills, "dashboarding")
+		}
+	}
+	publishToolAvailable := false
+	if decision.PublishReviewedGrafanaPreview {
+		selected = make(map[string]struct{}, 2)
+		for _, tool := range tools {
+			if tool.Name == "mcp-grafana_update_dashboard" || tool.Name == "mcp-grafana_get_dashboard_by_uid" {
+				selected[tool.Name] = struct{}{}
+				if tool.Name == "mcp-grafana_update_dashboard" {
+					publishToolAvailable = true
+				}
+			}
+		}
+		if !containsString(decision.Skills, "dashboarding") {
+			decision.Skills = append(decision.Skills, "dashboarding")
+		}
+	}
+	filtered := make([]mcp.Tool, 0, len(selected))
+	for _, tool := range tools {
+		if _, ok := selected[tool.Name]; ok {
+			filtered = append(filtered, tool)
+		}
+	}
+	if len(decision.Tools) > 0 && len(filtered) == 0 {
+		a.logger.Warn("Dynamic capability selection chose no known tools; retaining authorized tool set")
+		return tools, selectedSkillMessages(decision.Skills), false, false
+	}
+	preparePreview := decision.PrepareGrafanaPreviewAfterExecution && previewToolAvailable
+	publishPreview := decision.PublishReviewedGrafanaPreview && publishToolAvailable
+	skillMessages := selectedSkillMessages(decision.Skills)
+	a.logger.Info("Dynamically selected capabilities", "availableTools", len(tools), "selectedTools", len(filtered), "selectedSkills", decision.Skills, "prepareGrafanaPreviewAfterExecution", preparePreview, "publishReviewedGrafanaPreview", publishPreview)
