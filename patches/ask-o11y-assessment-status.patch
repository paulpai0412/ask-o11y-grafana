diff --git a/pkg/agent/delivery_producer_test.go b/pkg/agent/delivery_producer_test.go
--- a/pkg/agent/delivery_producer_test.go
+++ b/pkg/agent/delivery_producer_test.go
@@ -14,6 +14,31 @@
 	"consensys-asko11y-app/pkg/mcp"
 	"github.com/grafana/grafana-plugin-sdk-go/backend/log"
 )
+
+func TestUnassessedIsNotMissingDelivery(t *testing.T) {
+	state := newDeliveryState("Explain the observations")
+	state.observeCall("data-query-planner_plan_query", `{"business_question":"Explain the observations"}`, `{"ok":true,"refs":{"plan_ref":"artifact://plan/query-plan"}}`, false)
+	if state.deliveryStatus() != "not_assessed" || len(state.gaps) != 0 {
+		t.Fatalf("planning manufactured an analytical gap: %#v", state)
+	}
+	state.observeCall("grafana-query_execute_planned_query", `{"plan_ref":"artifact://plan/query-plan"}`, `{"ok":true,"refs":{"frame_ref":"artifact://plan/grafana-frame"}}`, false)
+	if len(state.gaps) != 0 {
+		t.Fatal("query manufactured an analytical gap")
+	}
+	state.observe("sandbox-analysis_execute_python_analysis", `{"ok":true,"refs":{"execution_ref":"artifact://run/sandbox-execution"}}`, false)
+	if len(state.gaps) != 0 {
+		t.Fatal("successful computation manufactured an analytical gap")
+	}
+	state.observe("mcp-grafana_update_dashboard", `{"uid":"saved"}`, false)
+	text := state.warning()
+	if !strings.Contains(text, "not a finding of missing work or failure") || !strings.Contains(text, "succeeded") || strings.Contains(text, "Host delivery status: not_assessed") {
+		t.Fatalf("assessment and persistence were conflated: %s", text)
+	}
+	state.observe("sandbox-analysis_execute_python_analysis", `{"ok":false,"error":"actual failure"}`, true)
+	if !strings.Contains(state.warning(), "Tool failed") || len(state.gaps) == 0 {
+		t.Fatal("real failure was hidden")
+	}
+}
 
