+package plugin
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+)
+
+func TestReportCursorOpaqueState(t *testing.T) {
+	path := os.Getenv("REPORT_CURSOR_FIXTURE_OUT")
+	if path == "" {
+		t.Skip("set REPORT_CURSOR_FIXTURE_OUT from scripts/check-report-evidence-cursor.py")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixture map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fixture); err != nil {
+		t.Fatal(err)
+	}
+	calls := []map[string]interface{}{}
+	for _, key := range []string{"initial", "continuation", "composed"} {
+		calls = append(calls, map[string]interface{}{
+			"name":     "artifact-bridge_inspect_report_artifacts",
+			"response": map[string]interface{}{"content": []map[string]interface{}{{"type": "text", "text": string(fixture[key])}}},
+		})
+	}
+	calls[2]["name"] = "artifact-bridge_compose_ml_dashboard"
+	raw, err := json.Marshal(calls)
+	if err != nil {
+		t.Fatal(err)
+	}
+	state := compactPriorToolState(raw)
+	records := decodePriorState(t, state) // The host wraps bounded JSON in a context marker.
+	if len(records) != 3 {
+		t.Fatal("cursor tool records were lost")
+	}
+	refs, ok := records[2]["refs"].(map[string]interface{})
+	if !ok {
+		t.Fatal("latest cursor refs were lost")
+	}
+	var composed struct {
+		Refs map[string]string `json:"refs"`
+	}
+	if err := json.Unmarshal(fixture["composed"], &composed); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{"inspection_ref", "report_manifest_ref", "report_context_ref", "dashboard_ref"} {
+		if composed.Refs[key] == "" || refs[key] != composed.Refs[key] {
+			t.Fatalf("lost %s", key)
+		}
+	}
+}
