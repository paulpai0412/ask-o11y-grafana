+// Uses actual Bridge RPC outputs; does not assert live model understanding.
+func TestReportCursorDeliveryBinding(t *testing.T) {
+	path := os.Getenv("REPORT_CURSOR_FIXTURE_OUT")
+	if path == "" {
+		t.Skip("set REPORT_CURSOR_FIXTURE_OUT from scripts/check-report-evidence-cursor.py")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var f map[string]json.RawMessage
+	if err := json.Unmarshal(data, &f); err != nil {
+		t.Fatal(err)
+	}
+	decode := func(key string) map[string]interface{} {
+		var value map[string]interface{}
+		if err := json.Unmarshal(f[key], &value); err != nil {
+			t.Fatal(err)
+		}
+		return value
+	}
+	manifest := firstRef(decode("initial"), "report_manifest_ref")
+	context := firstRef(decode("initial"), "report_context_ref")
+	state := newDeliveryState("Compare observed signals")
+	state.setResolvedToolNames([]string{"artifact-bridge_inspect_report_artifacts", "artifact-bridge_compose_ml_dashboard"})
+	for _, step := range []string{"initial", "continuation", "compose"} {
+		tool, payload := "artifact-bridge_inspect_report_artifacts", step
+		if step == "compose" {
+			tool, payload = "artifact-bridge_compose_ml_dashboard", "composed"
+		}
+		state.observeCall(tool, string(f[step+"_args"]), string(f[payload]), false)
+		if state.reportContextRef != context || state.reportManifestRef != manifest {
+			t.Fatalf("%s lost actual report binding: %+v", step, state)
+		}
+		if strings.Contains(strings.Join(state.gaps, " "), "REPORT_BINDING_NOT_VERIFIED") {
+			t.Fatalf("%s: %+v", step, state.gaps)
+		}
+		if state.delivery != "not_assessed" || state.writerStatus != "" {
+			t.Fatalf("inspection/composition promoted analysis or writing: %+v", state)
+		}
+	}
+	for _, key := range []string{"inspection_ref", "report_context_ref", "report_manifest_ref"} {
+		bad := decode("composed")
+		bad["refs"].(map[string]interface{})[key] = "artifact://wrong/report-inspection"
+		raw, err := json.Marshal(bad)
+		if err != nil {
+			t.Fatal(err)
+		}
+		state.observeCall("artifact-bridge_compose_ml_dashboard", string(f["compose_args"]), string(raw), false)
+		if !strings.Contains(strings.Join(state.gaps, " "), "REPORT_BINDING_NOT_VERIFIED") {
+			t.Fatalf("accepted mismatched %s", key)
+		}
+	}
+	resumed := newDeliveryState("Compare observed signals")
+	resumed.observeCall("artifact-bridge_compose_ml_dashboard", string(f["compose_args"]), string(f["composed"]), false)
+	if resumed.reportContextRef != context {
+		t.Fatal("could not bind authorized retained cursor on resume")
+	}
+	rejected := newDeliveryState("Different plan")
+	rejected.planRef, rejected.planSHA = "artifact://current/query-plan", "different-plan-hash"
+	rejected.observeCall("artifact-bridge_inspect_report_artifacts", string(f["initial_args"]), string(f["initial"]), false)
+	if rejected.reportContextRef != "" {
+		t.Fatal("inspection bypassed current plan binding")
+	}
+	ignored := newDeliveryState("Unselected tool")
+	ignored.setResolvedToolNames([]string{"mcp-grafana_update_dashboard"})
+	ignored.observeCall("artifact-bridge_inspect_report_artifacts", string(f["initial_args"]), string(f["initial"]), false)
+	if ignored.reportContextRef != "" {
+		t.Fatal("unselected inspection tool gained authority")
+	}
+}
+
+func TestReportCursorSchemaReachesLLM(t *testing.T) {
+	path := os.Getenv("REPORT_CURSOR_FIXTURE_OUT")
+	if path == "" {
+		t.Skip("generate REPORT_CURSOR_FIXTURE_OUT with the public Bridge regression")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixture struct {
+		Tools       []mcp.Tool      `json:"tools"`
+		Initial     json.RawMessage `json:"initial"`
+		InitialArgs json.RawMessage `json:"initial_args"`
+	}
+	if err := json.Unmarshal(data, &fixture); err != nil {
+		t.Fatal(err)
+	}
+	if len(fixture.Tools) != 2 {
+		t.Fatal("missing public report tools")
+	}
+	t.Setenv("ASKO11Y_EFFECT_STORE", t.TempDir())
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/mcp/list-tools" {
+			_ = json.NewEncoder(w).Encode(map[string]interface{}{"tools": fixture.Tools})
+			return
+		}
+		_ = json.NewEncoder(w).Encode(mcp.CallToolResult{Content: []mcp.ContentBlock{{Type: "text", Text: string(fixture.Initial)}}})
+	}))
+	defer server.Close()
+	requests := make(chan ChatCompletionRequest, 8)
+	calls := 0
+	llm := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body ChatCompletionRequest
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+			return
+		}
+		requests <- body
+		message := Message{Role: "assistant", Content: "More evidence remains; do not compose yet."}
+		if calls == 0 {
+			message.Content = `{"tools":["artifact-bridge_inspect_report_artifacts","artifact-bridge_compose_ml_dashboard"],"skills":[]}`
+		} else if calls == 1 {
+			message = Message{Role: "assistant", ToolCalls: []ToolCall{{ID: "read-report", Type: "function", Function: FunctionCall{Name: "artifact-bridge_inspect_report_artifacts", Arguments: string(fixture.InitialArgs)}}}}
+		}
+		calls++
+		respondAsStream(w, ChatCompletionResponse{Choices: []Choice{{Message: message, FinishReason: "stop"}}})
+	}))
+	defer llm.Close()
+	proxy := mcp.NewProxy(context.Background(), log.DefaultLogger)
+	defer proxy.Close()
+	if err := proxy.EnsureServer(mcp.ServerConfig{ID: "artifact-bridge", URL: server.URL, Type: "standard", Enabled: true}); err != nil {
+		t.Fatal(err)
+	}
+	client, err := httpclient.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.CloseIdleConnections()
+	loop := NewAgentLoop(NewLLMClient(log.DefaultLogger, client), proxy, log.DefaultLogger)
+	events := make(chan SSEEvent, 64)
+	req := LoopRequest{Messages: []Message{{Role: "user", Content: "Prepare a report from retained evidence."}}, SystemPrompt: "Custom prompt", MaxIterations: 3, GrafanaURL: llm.URL, AuthToken: "synthetic", UserRole: "Admin", UserID: "cursor-check", SessionID: "cursor-session", OrgID: "1", MCPServers: []mcp.ServerConfig{{ID: "artifact-bridge", Enabled: true}}}
+	req.RegisterApproval = func(_ context.Context, a ApprovalRequestEvent) (ApprovalWaitFunc, error) {
+		return func(context.Context) (ApprovalResolvedEvent, error) {
+			return ApprovalResolvedEvent{ApprovalID: a.ApprovalID, Decision: "approved"}, nil
+		}, nil
+	}
+	go loop.Run(context.Background(), req, events)
+	for event := range events {
+		if event.Type == "error" {
+			t.Errorf("loop error: %+v", event)
+		}
+		if event.Type == "tool_call_start" {
+			var args map[string]interface{}
+			if err := json.Unmarshal([]byte(event.Data.(ToolCallStartEvent).Arguments), &args); err != nil || args["mode"] != "spec" {
+				t.Error("transport default was not bound before dispatch/approval")
+			}
+		}
+	}
+	seen := map[string]bool{}
+	seenEvidence := false
+	for len(requests) > 0 {
+		request := <-requests
+		for _, message := range request.Messages {
+			if message.Role == "tool" && message.Content == string(fixture.Initial) {
+				seenEvidence = true
+			} else if message.Role == "tool" {
+				t.Logf("non-fixture tool message: %.600s", message.Content)
+			}
+		}
+		for _, definition := range request.Tools {
+			for _, tool := range fixture.Tools {
+				if definition.Function.Name != "artifact-bridge_"+tool.Name {
+					continue
+				}
+				want, err := json.Marshal(tool.InputSchema)
+				if err != nil {
+					t.Fatal(err)
+				}
+				got, err := json.Marshal(definition.Function.Parameters)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if string(got) != string(want) || definition.Function.Description != tool.Description {
+					t.Fatalf("public schema/description drifted for %s", tool.Name)
+				}
+				seen[tool.Name] = true
+			}
+		}
+	}
+	if len(seen) != 2 || !seenEvidence {
+		t.Fatalf("report schemas/evidence did not reach actual LLM requests: schemas=%v evidence=%v", seen, seenEvidence)
+	}
+}
+
+func TestReportCursorTransportDefault(t *testing.T) {
+	name := "artifact-bridge_inspect_report_artifacts"
+	call := ToolCall{Function: FunctionCall{Name: name, Arguments: `{"inspection_ref":"artifact://retained/report-inspection"}`}}
+	bound := bindTrustedToolCall(call, LoopRequest{})
+	var args map[string]interface{}
+	if err := json.Unmarshal([]byte(bound.Function.Arguments), &args); err != nil {
+		t.Fatal(err)
+	}
+	if args["mode"] != "spec" || validateInspectionTransport(name, args) != nil {
+		t.Fatal("absent mode did not bind to supported text transport")
+	}
+	for _, mode := range []interface{}{nil, "", "vision", false, 0, []string{"spec"}} {
+		raw, err := json.Marshal(map[string]interface{}{"inspection_ref": "artifact://retained/report-inspection", "mode": mode})
+		if err != nil {
+			t.Fatal(err)
+		}
+		call.Function.Arguments = string(raw)
+		bound := bindTrustedToolCall(call, LoopRequest{})
+		if bound.Function.Arguments != string(raw) {
+			t.Fatal("explicit invalid mode was silently changed")
+		}
+		if err := json.Unmarshal([]byte(bound.Function.Arguments), &args); err != nil {
+			t.Fatal(err)
+		}
+		if validateInspectionTransport(name, args) == nil {
+			t.Fatalf("unsupported mode accepted: %v", mode)
+		}
+	}
+}
