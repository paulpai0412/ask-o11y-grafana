+
+func TestSelectRelevantToolsKeepsDynamicSelectionNarrow(t *testing.T) {
+	loop, grafanaURL, cleanup := setupTestLoop(t, []ChatCompletionResponse{{
+		Choices: []Choice{{
+			Message:      Message{Role: "assistant", Content: `{"tools":["mcp-grafana_update_dashboard"],"skills":["dashboarding"],"datasource_families":[],"prepare_grafana_preview_after_execution":true,"publish_reviewed_grafana_preview":false}`},
+			FinishReason: "stop",
+		}},
+	}})
+	defer cleanup()
+
+	tools := []mcp.Tool{
+		{Name: "mcp-grafana_update_dashboard"},
+		{Name: "mcp-grafana_query_prometheus"},
+		{Name: "artifact-bridge_compose_ml_dashboard"},
+		{Name: "mcp-grafana_get_dashboard_by_uid"},
+	}
+	selected, _, prepare, publish := loop.selectRelevantTools(context.Background(), LoopRequest{
+		Model:      "base",
+		GrafanaURL: grafanaURL,
+		Messages:   []Message{{Role: "user", Content: "analyze the uploaded dataset and create a Grafana preview"}},
+		MCPServers: []mcp.ServerConfig{{ID: "mcp-grafana", Enabled: true}},
+	}, tools)
+	if !prepare || publish {
+		t.Fatalf("preview selection = prepare:%t publish:%t, want true,false", prepare, publish)
+	}
+	var names []string
+	for _, tool := range selected {
+		names = append(names, tool.Name)
+	}
+	if got := strings.Join(names, ","); got != "mcp-grafana_update_dashboard,artifact-bridge_compose_ml_dashboard" {
+		t.Fatalf("selected tools = %q, want writer and composer only", got)
+	}
+	if !isExecutionResult(`{"ok":true,"step":"profile_dataset"}`) {
+		t.Fatal("successful profile result was not recognized")
+	}
+}
