{
  "servers": [
    {
      "id": "data-query-planner",
      "name": "Data Query Planner Workflow Node",
      "url_env": "DATA_QUERY_PLANNER_MCP_URL",
      "local_url": "http://127.0.0.1:8768/mcp",
      "enabled_tools": ["plan_query"],
      "disabled_tools": ["validate_query"]
    },
    {
      "id": "grafana-query",
      "name": "Grafana Metadata and Query Read Boundary",
      "url_env": "GRAFANA_QUERY_MCP_URL",
      "local_url": "http://127.0.0.1:8772/mcp",
      "enabled_tools": ["discover_datasets", "inspect_dataset", "execute_planned_query"],
      "disabled_tools": []
    },
    {
      "id": "sandbox-analysis",
      "name": "Isolated Dynamic Python Analysis",
      "url_env": "SANDBOX_ANALYSIS_MCP_URL",
      "local_url": "http://127.0.0.1:8777/mcp",
      "enabled_tools": ["execute_python_analysis", "list_python_analyses", "inspect_python_analysis", "revise_python_analysis"],
      "disabled_tools": []
    },
    {
      "id": "grafana-renderer",
      "name": "Grafana Renderer Workflow Node",
      "url_env": "GRAFANA_RENDERER_MCP_URL",
      "local_url": "http://127.0.0.1:8773/mcp",
      "enabled_tools": ["prepare_dashboard_write", "create_dashboard_from_artifacts"],
      "disabled_tools": []
    }
  ]
}
