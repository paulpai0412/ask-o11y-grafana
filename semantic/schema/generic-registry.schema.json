{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask-o11y.local/schema/generic-ontology-registry-v1.json",
  "title": "Ask O11y generic ontology registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "snapshot_id", "namespace", "status", "provenance", "datasets"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "snapshot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "status": {"const": "approved"},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["registry_path", "source_refs", "owner", "effective_from"],
      "properties": {
        "registry_path": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "minLength": 1},
        "effective_from": {"type": "string", "format": "date"}
      }
    },
    "datasets": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/dataset"}}
  },
  "$defs": {
    "status": {"enum": ["observed", "proposed", "approved", "rejected", "deprecated"]},
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_id", "physical_name", "type", "semantic_kind", "status", "reason"],
      "properties": {
        "canonical_id": {"type": "string", "pattern": "^field\\.[a-z0-9._-]+$"},
        "physical_name": {"type": "string", "minLength": 1},
        "type": {"enum": ["date", "datetime", "string", "number", "integer", "boolean", "object"]},
        "unit": {"type": ["string", "null"]},
        "semantic_kind": {"enum": ["temporal", "identifier", "measurement", "dimension", "metric", "event_attribute", "state", "unknown"]},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"type": "string", "minLength": 1},
        "source": {"type": "object"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_id", "from_dataset", "to_dataset", "from_fields", "to_fields", "cardinality", "status", "executable", "reason"],
      "properties": {
        "canonical_id": {"type": "string", "pattern": "^relation\\.[a-z0-9._-]+$"},
        "from_dataset": {"type": "string", "minLength": 1},
        "to_dataset": {"type": "string", "minLength": 1},
        "from_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "to_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cardinality": {"enum": ["1:1", "1:N", "N:1", "N:N", "unknown"]},
        "status": {"$ref": "#/$defs/status"},
        "executable": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "source": {"type": "object"},
        "evidence": {"type": "object"}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_id", "physical_id", "asset_kind", "status", "grain", "entity_key", "fields"],
      "properties": {
        "canonical_id": {"type": "string", "pattern": "^dataset\\.[a-z0-9._-]+$"},
        "physical_id": {"type": "string", "minLength": 1},
        "asset_kind": {"enum": ["tabular_file", "sql_table", "timeseries", "log_stream", "event_topic", "api_resource"]},
        "status": {"$ref": "#/$defs/status"},
        "grain": {"type": "string", "minLength": 1},
        "entity_key": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "time_identity": {"type": ["string", "null"]},
        "fields": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/field"}},
        "relations": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/relation"}},
        "source": {"type": "object"}
      }
    }
  }
}
