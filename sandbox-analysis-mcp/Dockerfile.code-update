# Code-only deployment: reuse the installed dependency image, never install packages.
# Before building, verify BASE_IMAGE's ID against the deployment receipt.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY ml_plotly_contract.py /opt/ask-o11y/ml_plotly_contract.py
# Remove retired application code inherited from the dependency image.
RUN rm -f /opt/ask-o11y/_plotly_legacy.py \
    /opt/ask-o11y/ml_preprocessing.py /opt/ask-o11y/ml_execution.py \
    /opt/ask-o11y/ml_autoresearch.py /opt/ask-o11y/ml_regression.py \
    /opt/ask-o11y/ml_presentation.py /opt/ask-o11y/data_profile.py
COPY capture.py /opt/ask-o11y/capture.py
